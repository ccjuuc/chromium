# of //build/config/BUILDCONFIG.gn.

import("//build/config/cast.gni")
import("//build/config/chrome_build.gni")

declare_args() {
  # Enables proprietary codecs and demuxers; e.g. H264, AAC, MP3, and MP4.
  # Default true in this tree; set proprietary_codecs=false in args.gn to
  # disable. (Upstream Chromium defaults this off for unbranded builds.)
  #
  # With proprietary_codecs=true, //media/BUILD.gn requires
  # ffmpeg_branding != "Chromium" (use ffmpeg_branding="Chrome" in args.gn if
  # `gn gen` fails on that assert).
  proprietary_codecs = true

  # libudev usage. This currently only affects the content layer.
  use_udev = (is_linux && !is_castos) || is_chromeos

  use_dbus = is_linux || is_chromeos

  use_gio = is_linux && !is_castos && target_os != "android"

  use_blink = !is_ios
}
