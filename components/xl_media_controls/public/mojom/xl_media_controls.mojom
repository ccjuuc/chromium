module xl_media_controls.mojom;

import "url/mojom/url.mojom";

// Renderer (Blink media controls) -> browser: XL media control actions.
interface XlMediaControlsHost {
  // Download media from the given URL. Triggered by the xl1 side-button on
  // the video player controls. The download is initiated on the browser side
  // to avoid threading issues in the Chromium download pipeline.
  DownloadMediaUrl(url.mojom.Url media_url, string suggested_filename);
};
