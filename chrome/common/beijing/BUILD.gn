import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [
    "beijing_page_api.mojom",
  ]
  public_deps = [
    "//mojo/public/mojom/base",
  ]
}

# Platform-neutral names for //tools/render_dll_* (GetNativeLibraryName).
# Module list lives in render_dll_names.h (compile-time constexpr).
