diff --git a/mac/main/mac-player-capability.ts b/mac/main/mac-player-capability.ts
new file mode 100644
index 0000000000000000000000000000000000000000..98ccd88f1123459356eef1e4b79f67b6d18fe3fe
--- /dev/null
+++ b/mac/main/mac-player-capability.ts
@@ -0,0 +1,60 @@
+import * as electron from 'electron'
+import path from 'path'
+
+import type { MacPlayerNativeAddon } from './mac-player-runtime'
+
+/** Optional host extension. Electron itself continues to own the native SDK. */
+export interface XenonMacPlayer {
+  version: 1
+  adapterId: 'xunlei.mac-player'
+  adapterVersion: 1
+  getAddon(addonPath: string): MacPlayerNativeAddon
+  attachWindow(windowId: number): void
+  detachWindow(windowId: number): void
+}
+
+type CapabilityEnvironment = {
+  platform: string
+  processType: string | undefined
+  electron: unknown
+}
+
+function currentEnvironment(): CapabilityEnvironment {
+  return { platform: process.platform, processType: process.type, electron }
+}
+
+export function getXenonMacPlayer(
+  environment: CapabilityEnvironment = currentEnvironment()
+): XenonMacPlayer | undefined {
+  if (environment.platform !== 'darwin' || environment.processType !== 'browser') return
+  const candidate = (environment.electron as { xenonMacPlayer?: XenonMacPlayer } | undefined)
+    ?.xenonMacPlayer
+  if (candidate === undefined) return
+  if (
+    candidate?.version === 1 &&
+    candidate.adapterId === 'xunlei.mac-player' &&
+    candidate.adapterVersion === 1 &&
+    typeof candidate.getAddon === 'function' &&
+    typeof candidate.attachWindow === 'function' &&
+    typeof candidate.detachWindow === 'function'
+  ) {
+    return candidate
+  }
+  throw new Error(
+    'Unsupported Mac player host contract: requires xunlei.mac-player adapter version 1'
+  )
+}
+
+export function requireMacPlayerAddon(
+  id: string,
+  requireNative: (id: string) => any,
+  environment: CapabilityEnvironment = currentEnvironment()
+): any {
+  if (path.basename(id) === 'playercontrol.node') {
+    const capability = getXenonMacPlayer(environment)
+    // The Browser validates the full trusted addon path. A rejected request
+    // must not silently create a second SDK in the application's Utility.
+    if (capability) return capability.getAddon(id)
+  }
+  return requireNative(id)
+}
