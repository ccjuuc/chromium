@@ -1,27 +1,29 @@
 /**
- * Single Promise: 注意这个是指异步过程只产生一个Promise对象，
+ * 同一 key 的并发操作共享结果或错误，完成后允许重新发起。
  */
 export class SinglePromise {
-  private named_cbs: { [name: string]: ((result: any) => void)[] } = {};
-  
-  public async run<T>(key: string, fn: () => Promise<T>): Promise<T> {
-    return await new Promise<T>(async (v) => {
-      if (this.named_cbs[key]) {
-        this.named_cbs[key].push((result: T) => {
-          v(result)
-        })
-      } else {
-        this.named_cbs[key] = [(result: T) => {
-          v(result);
-        }];
+  private pendingByKey = new Map<string, Promise<unknown>>();
 
-        const result = await fn();
-        let temp = this.named_cbs[key];
-        delete this.named_cbs[key];
-        temp.forEach((cb) => {
-          cb(result);
-        });
-      }
+  public run<T>(key: string, fn: () => Promise<T>): Promise<T> {
+    const existing = this.pendingByKey.get(key);
+    if (existing) return existing as Promise<T>;
+
+    let resolveOperation!: (value: T | PromiseLike<T>) => void;
+    let rejectOperation!: (reason: unknown) => void;
+    const operation = new Promise<T>((resolve, reject) => {
+      resolveOperation = resolve;
+      rejectOperation = reject;
+    });
+    const pending = operation.finally(() => {
+      this.pendingByKey.delete(key);
     });
+    // 先登记再调用，保持原有同步启动时序，并让同步重入复用同一请求。
+    this.pendingByKey.set(key, pending);
+    try {
+      resolveOperation(fn());
+    } catch (error) {
+      rejectOperation(error);
+    }
+    return pending;
   }
 }
