import("//tools/grit/grit_rule.gni")

grit("resources_grit") {
  source = "xenon_resources.grd"
  outputs = [
    "grit/xenon_resources.h",
    "xenon_resources.pak",
  ]
  deps = [ "webui:resources" ]
}

# Copy extension files to root output directory (for Windows/Linux)
copy("copy_extension") {
  sources = [
    "extension/manifest.json",
    "extension/index.html",
    "extension/main.js",
    "extension/background.js",
  ]
  outputs = [ "$root_out_dir/resources/xenon_extension/{{source_file_part}}" ]
}

# Copy extension files to macOS app bundle Resources directory using bundle_data
# (following Chromium's official approach)
if (is_mac) {
  bundle_data("copy_extension_mac") {
    sources = [
      "extension/manifest.json",
      "extension/index.html",
      "extension/main.js",
      "extension/background.js",
    ]
    outputs = [ "{{bundle_resources_dir}}/resources/xenon_extension/{{source_file_part}}" ]
  }
}

group("resources") {
  public_deps = [
    ":resources_grit",
    ":copy_extension",
  ]

  if (is_mac) {
    public_deps += [ ":copy_extension_mac" ]
  }
}
