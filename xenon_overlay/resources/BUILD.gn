import("//third_party/node/node.gni")
import("//tools/grit/grit_rule.gni")
import("//xenon_overlay/buildflags/features.gni")
import("electron_apps.gni")
import("ipc/bootstrap_sources.gni")
import("thunder_macos.gni")

node("ipc_bootstrap") {
  script = "//third_party/node/node.py"
  inputs = ipc_bootstrap_sources +
           [ "//xenon_overlay/tools/bundle_ipc_bootstrap.cjs" ]
  outputs = [
    "$target_gen_dir/ipc/xenon_ipc_main_bootstrap.js",
    "$target_gen_dir/ipc/xenon_ipc_renderer_bootstrap.js",
  ]
  depfile = "$target_gen_dir/ipc/bootstrap.d"
  args = [
    rebase_path("//xenon_overlay/tools/bundle_ipc_bootstrap.cjs",
                root_build_dir),
    "--entry",
    rebase_path("ipc/xenon_ipc_main_bootstrap.js", root_build_dir),
    "--entry",
    rebase_path("ipc/xenon_ipc_renderer_bootstrap.js", root_build_dir),
    "--output-dir",
    rebase_path("$target_gen_dir/ipc", root_build_dir),
    "--depfile",
    rebase_path(depfile, root_build_dir),
  ]
}

grit("resources_grit") {
  source = "xenon_resources.grd"
  outputs = [
    "grit/xenon_resources.h",
    "xenon_resources.pak",
  ]
  deps = [
    ":ipc_bootstrap",
    "webui:resources",
  ]
}

copy("copy_extension") {
  if (xenon_extension_source == "zip") {
    sources = [ "xenon_extension.zip" ]
    outputs = [ "$root_out_dir/resources/{{source_file_part}}" ]
  } else {
    sources = [
      "extension/background.js",
      "extension/index.html",
      "extension/main.js",
      "extension/manifest.json",
    ]
    outputs = [ "$root_out_dir/resources/xenon_extension/{{source_file_part}}" ]
  }
}

video_controls_extension_files = [
  "video_controls_extension/background.js",
  "video_controls_extension/content.js",
  "video_controls_extension/manifest.json",
  "video_controls_extension/options.html",
  "video_controls_extension/options.js",
]

copy("copy_video_controls_extension") {
  sources = video_controls_extension_files
  outputs = [
    "$root_out_dir/resources/video_controls_extension/{{source_file_part}}",
  ]
}

if (is_mac) {
  if (xenon_bundle_thunder_macos) {
    _thunder_archive = "//xenon_overlay/resources/thunder-2025-mac.tar.xz"
    _thunder_checksum = "//xenon_overlay/resources/thunder-2025-mac.sha256"
    _thunder_stage = "$target_gen_dir/thunder_macos"
    action("stage_thunder_macos") {
      script = "//xenon_overlay/tools/stage_thunder_macos_resources.py"
      inputs = [
        "//build/action_helpers.py",
        "//build/gn_helpers.py",
        _thunder_archive,
        _thunder_checksum,
      ]
      outputs = [
        "$target_gen_dir/thunder_macos.stamp",
        "$_thunder_stage/Thunder.app",
        "$_thunder_stage/thunder_2025.xenon.json",
      ]
      depfile = "$target_gen_dir/thunder_macos.d"
      args = [
        "--archive",
        rebase_path(_thunder_archive, root_build_dir),
        "--checksum",
        rebase_path(_thunder_checksum, root_build_dir),
        "--destination",
        rebase_path(_thunder_stage, root_build_dir),
        "--stamp",
        rebase_path(outputs[0], root_build_dir),
        "--depfile",
        rebase_path(depfile, root_build_dir),
      ]
    }

    bundle_data("thunder_macos_payload") {
      sources = [ "$_thunder_stage/Thunder.app" ]
      outputs = [ "{{bundle_resources_dir}}/xenon-apps/{{source_file_part}}" ]
      public_deps = [ ":stage_thunder_macos" ]
    }

    bundle_data("thunder_macos_descriptor") {
      sources = [ "$_thunder_stage/thunder_2025.xenon.json" ]
      outputs = [ "{{bundle_resources_dir}}/xenon-apps/{{source_file_part}}" ]
      public_deps = [ ":stage_thunder_macos" ]
    }
  }

  # Only chrome_app depends on these resources; putting them in the generic
  # resources group would also collect the payload inside the framework.
  group("thunder_macos_bundle_data") {
    if (xenon_bundle_thunder_macos) {
      public_deps = [
        ":thunder_macos_descriptor",
        ":thunder_macos_payload",
      ]
    }
  }

  bundle_data("copy_video_controls_extension_mac") {
    sources = video_controls_extension_files
    outputs = [ "{{bundle_resources_dir}}/resources/video_controls_extension/{{source_file_part}}" ]
  }

  bundle_data("copy_extension_mac") {
    if (xenon_extension_source == "zip") {
      sources = [ "xenon_extension.zip" ]
      outputs = [ "{{bundle_resources_dir}}/resources/{{source_file_part}}" ]
    } else {
      sources = [
        "extension/background.js",
        "extension/index.html",
        "extension/main.js",
        "extension/manifest.json",
      ]
      outputs = [ "{{bundle_resources_dir}}/resources/xenon_extension/{{source_file_part}}" ]
    }
  }
}

if (is_win) {
  foreach(app, xenon_electron_apps) {
    action("copy_electron_app_$app") {
      script = "//xenon_overlay/tools/copy_runtime_tree.py"
      inputs = [ app ]
      src_dir = app
      dst_dir = "$root_out_dir/$app"
      stamp_file = "$target_gen_dir/copy_electron_app_$app.stamp"
      depfile = "$target_gen_dir/copy_electron_app_$app.d"

      outputs = [ stamp_file ]
      args = [
        "--src",
        rebase_path(src_dir, root_build_dir),
        "--dest",
        rebase_path(dst_dir, root_build_dir),
        "--stamp",
        rebase_path(stamp_file, root_build_dir),
        "--depfile",
        rebase_path(depfile, root_build_dir),
      ]
    }
  }

  if (xenon_electron_app_host_files != []) {
    copy("copy_electron_app_configs") {
      sources = xenon_electron_app_host_files
      outputs = [ "$root_out_dir/{{source_file_part}}" ]
    }
  } else {
    group("copy_electron_app_configs") {
    }
  }

  group("copy_electron_apps") {
    public_deps = [ ":copy_electron_app_configs" ]
    foreach(app, xenon_electron_apps) {
      public_deps += [ ":copy_electron_app_$app" ]
    }
  }
}

group("resources") {
  public_deps = [
    ":copy_extension",
    ":copy_video_controls_extension",
    ":resources_grit",
  ]

  if (is_win) {
    public_deps += [ ":copy_electron_apps" ]
  }

  if (is_mac) {
    public_deps += [ ":copy_extension_mac" ]
    public_deps += [ ":copy_video_controls_extension_mac" ]
  }
}
