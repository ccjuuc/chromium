{
  "name": "Xenon Overlay Extension",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Extension based UI for Xenon Overlay",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Xenon Overlay",
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "sandbox": {
    "pages": []
  }
}
