import("//tools/grit/grit_rule.gni")
import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

build_webui("build") {
  grd_prefix = "xenon_player_webui"
  generate_grdp = true

  static_files = [ "xenon_player.html" ]

  ts_files = [
    "electron_shim.ts",
    "host.ts",
    "services/net_ipc.ts",
    "services/player_service.ts",
    "services/playlist_service.ts",
  ]

  mojo_files = [
    "$root_gen_dir/xenon_overlay/chrome/browser/ui/webui/xenon_node.mojom-webui.ts",
    "//xenon_overlay/resources/webui/shared/require.ts",
  ]
  mojo_files_deps = [
    "//xenon_overlay/chrome/browser/ui/webui:mojo_bindings_ts__generator",
  ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}

generate_grd("build_grd") {
  grd_prefix = "xenon_player_webui"
  out_grd = "$target_gen_dir/resources.grd"
  grdp_files = [ "$target_gen_dir/resources.grdp" ]
  deps = [ ":build_grdp" ]
}

grit("resources") {
  enable_input_discovery_for_gn_analyze = false
  source = "$target_gen_dir/resources.grd"
  deps = [ ":build_grd" ]
  resource_ids = ""

  outputs = [
    "grit/xenon_player_webui_resources.h",
    "grit/xenon_player_webui_resources_map.cc",
    "grit/xenon_player_webui_resources_map.h",
    "xenon_player_webui_resources.pak",
  ]

  grit_output_dir = "$target_gen_dir"
  output_dir = grit_output_dir
}
