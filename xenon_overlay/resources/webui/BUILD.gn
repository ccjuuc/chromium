import("//ui/webui/resources/tools/build_webui.gni")

build_webui("resources") {
  grd_prefix = "xenon_webui"

  # Keep generated Mojo JS next to `xenon/index.ts` so `./xenon.mojom-webui.js`
  # resolves at compile time and in the packaged `tsc/xenon/` output.
  mojo_base_path = "xenon"

  static_files = [
    "xenon/index.css",
    "xenon/index.html",
    "login/login.css",
    "login/login.html",
  ]

  ts_files = [ "xenon/index.ts" ]

  mojo_files = [
    "$root_gen_dir/xenon_overlay/chrome/browser/ui/webui/xenon.mojom-webui.ts",
  ]

  mojo_files_deps = [
    "//xenon_overlay/chrome/browser/ui/webui:mojo_bindings_ts__generator",
  ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  grit_output_dir = "$target_gen_dir"
}
