{
  "manifest_version": 3,
  "name": "XL Video Controls Bridge",
  "version": "1.0.5",
  "description": "Bridge Xenon built-in video side controls: show xl1–xr1 and relay xlcontrolaction events.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html"
}

