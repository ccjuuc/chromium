<?xml version="1.0" encoding="UTF-8"?>
<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/xenon_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="xenon_resources.pak"
            type="data_package" lang="en" />
  </outputs>
  <release seq="1">
    <messages>
      <message name="IDS_XENON_AI_SIDE_PANEL_TASK_MANAGER_TITLE"
          desc="Task manager title for Xenon AI side panel WebContents">
        Xenon AI
      </message>
    </messages>
    <includes>
      <include name="IDR_XENON_WEBUI_INDEX_HTML" file="webui/xenon/index.html" type="BINDATA" />
      <include name="IDR_XENON_WEBUI_INDEX_CSS" file="webui/xenon/index.css" type="BINDATA" />
      <include name="IDR_XENON_WEBUI_INDEX_JS" file="${root_gen_dir}/xenon_overlay/resources/webui/tsc/xenon/index.js" use_base_dir="false" type="BINDATA" />
      <include name="IDR_XENON_WEBUI_XENON_MOJOM_WEBUI_JS" file="${root_gen_dir}/xenon_overlay/resources/webui/tsc/xenon/xenon.mojom-webui.js" use_base_dir="false" type="BINDATA" />

      <!-- chrome://xenon-login/ — standalone HTML/CSS/JS（chrome.send，无 Mojo） -->
      <include name="IDR_XENON_LOGIN_HTML" file="webui/login/login.html" type="BINDATA" />
      <include name="IDR_XENON_LOGIN_CSS" file="webui/login/login.css" type="BINDATA" />
      <include name="IDR_XENON_LOGIN_JS" file="webui/login/login.js" type="BINDATA" />

      <!-- Simple WebUI Resources (no Mojo) -->
      <include name="IDR_SIMPLE_WEBUI_INDEX_HTML" file="webui/simple_webui/index.html" type="BINDATA" />
      <include name="IDR_SIMPLE_WEBUI_INDEX_CSS" file="webui/simple_webui/index.css" type="BINDATA" />
      <include name="IDR_SIMPLE_WEBUI_INDEX_JS" file="webui/simple_webui/index.js" type="BINDATA" />

      <!-- Dev smoke-test pages (packaged; no machine-local file://) -->
      <include name="IDR_LOCAL_VIDEO_TEST_HTML" file="webui/local_video_test/index.html" type="BINDATA" />
      <include name="IDR_RENDER_DLL_TEST_HTML" file="webui/render_dll_test/index.html" type="BINDATA" />
      
      <!-- Video Sniffer WebUI -->
      <include name="IDR_VIDEO_SNIFFER_WEBUI_INDEX_HTML" file="webui/video_sniffer/index.html" type="BINDATA" />
      <include name="IDR_VIDEO_SNIFFER_WEBUI_INDEX_CSS" file="webui/video_sniffer/index.css" type="BINDATA" />
      <include name="IDR_VIDEO_SNIFFER_WEBUI_INDEX_JS" file="webui/video_sniffer/index.js" type="BINDATA" />

      <!-- Xenon UI Test Page -->
      <include name="IDR_XENON_UI_HTML" file="webui/xenon_ui/xenon_ui.html" type="BINDATA" />
      <include name="IDR_XENON_UI_CSS" file="webui/xenon_ui/xenon_ui.css" type="BINDATA" />
      <include name="IDR_XENON_UI_JS" file="webui/xenon_ui/xenon_ui.js" type="BINDATA" />

      <include name="IDR_XENON_AI_SIDE_PANEL_HTML" file="webui/xenon_ai_side_panel/xenon_ai_side_panel.html" type="BINDATA" />
      <include name="IDR_XENON_AI_SIDE_PANEL_JS" file="webui/xenon_ai_side_panel/xenon_ai_side_panel.js" type="BINDATA" />
      <include name="IDR_XENON_AI_MOJOM_WEBUI_JS" file="${root_gen_dir}/xenon_overlay/resources/webui/tsc/xenon/xenon_ai.mojom-webui.js" use_base_dir="false" type="BINDATA" />

      <!-- Electron IPC Container Bootstrap -->
      <include name="IDR_XENON_IPC_MAIN_BOOTSTRAP_JS" file="ipc/xenon_ipc_main_bootstrap.js" type="BINDATA" />
      <include name="IDR_XENON_IPC_RENDERER_BOOTSTRAP_JS" file="ipc/xenon_ipc_renderer_bootstrap.js" type="BINDATA" />
      <include name="IDR_XENON_IPC_TEST_MAIN_JS" file="ipc/xenon_ipc_test_main.js" type="BINDATA" />

      <!-- Generic Electron container test page (sidebar XPE). -->
      <include name="IDR_XENON_PLAYER_BY_ELEC_HTML" file="webui/xenon_player_by_elec/index.html" type="BINDATA" />
      <include name="IDR_XENON_PLAYER_BY_ELEC_CSS" file="webui/xenon_player_by_elec/index.css" type="BINDATA" />
      <include name="IDR_XENON_PLAYER_BY_ELEC_JS" file="webui/xenon_player_by_elec/index.js" type="BINDATA" />
    </includes>
  </release>
</grit>
