module xenon.mojom;

import "services/network/public/mojom/url_loader_factory.mojom";
import "sandbox/policy/mojom/sandbox.mojom";

// Multiplexed on the same message pipe as XenonMainService (FIFO ordering).
interface XenonAssociatedSide {
  PingAssociated() => (string response);
};

// Implemented in the browser process; utility holds a Remote to push events.
interface XenonBrowserObserver {
  OnServiceEvent(string message);
};

[ServiceSandbox=sandbox.mojom.Sandbox.kUtility]
interface XenonMainService {
  // Initialize the service with a URLLoaderFactory to enable network requests.
  Initialize(pending_remote<network.mojom.URLLoaderFactory> url_loader_factory);

  // Simple ping method for testing
  Ping() => (string response);

  // Binds an associated interface on this service's primary pipe (browser uses
  // AssociatedRemote + BindNewEndpointAndPassReceiver).
  BindAssociatedSide(pending_associated_receiver<XenonAssociatedSide> receiver);

  // Browser passes its observer; utility calls OnServiceEvent for async notifications.
  SetBrowserObserver(pending_remote<XenonBrowserObserver> observer);
};
