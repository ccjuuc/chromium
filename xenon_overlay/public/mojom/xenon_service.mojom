module xenon.mojom;

import "mojo/public/mojom/base/values.mojom";
import "sandbox/policy/mojom/sandbox.mojom";
import "services/network/public/mojom/url_loader_factory.mojom";
import "xenon_overlay/public/mojom/xenon_ipc.mojom";

// Multiplexed on the same message pipe as XenonMainService (FIFO ordering).
interface XenonAssociatedSide {
  PingAssociated() => (string response);
};

// Implemented in the browser process; utility holds a Remote to push events.
interface XenonBrowserObserver {
  OnServiceEvent(string message);

  OnThreadCallback(string message);

  // Electron BrowserWindow backing. Called from the Utility ipcMain isolate;
  // HWND is returned synchronously so getNativeWindowHandle() can run in the
  // constructor, matching Electron.
  [Sync]
  CreateElectronWindow(int32 width,
                       int32 height,
                       bool show,
                       bool frame,
                       bool transparent,
                       int32 parent_id,
                       string title,
                       string container_id)
      => (int32 window_id, uint64 hwnd, string error);

  LoadElectronWindowURL(int32 window_id, string url);

  SetElectronWindowVisible(int32 window_id, bool visible);

  // Generic synchronous BrowserWindow operation bridge. The Electron main
  // isolate lives in Utility, while native Widgets must be controlled on the
  // Browser UI thread. Commands map to BrowserWindow primitives (bounds,
  // focus, show state, etc.), never to application/addon function names.
  [Sync]
  ElectronWindowCall(int32 window_id,
                     string command,
                     mojo_base.mojom.Value arguments)
      => (mojo_base.mojom.Value result, string error);

  CloseElectronWindow(int32 window_id);

  // Electron `dialog.showOpenDialog`. Must run on the Browser UI thread with
  // a real owner HWND. Calling GetOpenFileName from Utility never shows a
  // picker (no UI pump / no owner).
  [Sync]
  ShowElectronOpenDialog(string title,
                         bool directory,
                         bool allow_multi,
                         array<string> extensions)
      => (array<string> file_paths);
};

// Receives callbacks retained and invoked by a loaded Node addon.
interface NodeAddonObserver {
  OnCallback(int32 callback_id, array<mojo_base.mojom.Value> args);

  OnCallbackReleased(int32 callback_id);
};

struct NodeInvokeArg {
  bool is_callback;
  int32 callback_id;
  mojo_base.mojom.Value value;
};

struct NodeCallbackResult {
  int32 callback_id;
  mojo_base.mojom.Value value;
};

// Property metadata for a value exposed by a Node addon.
struct NodeExportInfo {
  string name;
  // "undefined", "null", "boolean", "number", "string", "bigint",
  // "symbol", "function", "object", "class", or "property".
  string kind;
  bool enumerable;
  bool writable;
  bool has_value;
  mojo_base.mojom.Value value;
  // Own members, including static members for functions and classes.
  array<NodeExportInfo> children;
  // Members inherited from a custom prototype. For classes, these are
  // instance members from Constructor.prototype.
  array<NodeExportInfo> prototype;
};

struct NodeInvokeCall {
  string function_name;
  array<NodeInvokeArg> args;
};

struct NodeInvokeCallResult {
  bool success;
  mojo_base.mojom.Value result;
  array<NodeCallbackResult> callback_results;
  string error_msg;
};

[ServiceSandbox=sandbox.mojom.Sandbox.kNoSandbox]
interface XenonMainService {
  // Initialize the service with a URLLoaderFactory to enable network requests.
  Initialize(
      pending_remote<network.mojom.URLLoaderFactory> url_loader_factory);

  // Simple ping method for testing
  Ping() => (string response);

  // Binds an associated interface on this service's primary pipe (browser uses
  // AssociatedRemote + BindNewEndpointAndPassReceiver).
  BindAssociatedSide(
      pending_associated_receiver<XenonAssociatedSide> receiver);

  // Browser passes its observer; utility calls OnServiceEvent for async
  // notifications.
  SetBrowserObserver(pending_remote<XenonBrowserObserver> observer);

  // One observer per chrome://xenon-node page. Native callback ids are scoped
  // by context_id + client_id so independent Electron containers cannot
  // consume each other's callbacks.
  SetNodeAddonObserver(
      string context_id,
      int32 client_id,
      pending_remote<NodeAddonObserver> observer);

  // Browser brokers this receiver for a renderer, then leaves the synchronous
  // native-addon call path entirely.
  BindNodeAddonHost(
      string context_id,
      pending_receiver<xenon.ipc.mojom.NodeAddonHost> receiver);

  // Native Widget/window-message events forwarded to the Electron-compatible
  // main isolate. Window ids are process-global and containers without the id
  // simply ignore the event.
  DispatchElectronWindowEvent(int32 window_id,
                              string event_name,
                              mojo_base.mojom.Value arguments);

  // Electron-compatible main JavaScript container. It runs in this unsandboxed
  // Utility process because the Browser process forbids executable JIT pages.
  InitializeElectronIpc(xenon.ipc.mojom.IpcMainConfig config)
      => (bool success, string error_msg);

  RegisterElectronIpcRenderer(
      string container_id,
      string endpoint_id,
      pending_remote<xenon.ipc.mojom.IpcRenderer> renderer,
      int32 process_id,
      int32 frame_id,
      int32 window_id);

  RemoveElectronIpcRenderer(string container_id, string endpoint_id);

  ElectronIpcSend(string container_id,
                  string endpoint_id,
                  string channel,
                  mojo_base.mojom.Value arguments);

  ElectronIpcInvoke(string container_id,
                    string endpoint_id,
                    string channel,
                    mojo_base.mojom.Value arguments)
      => (xenon.ipc.mojom.IpcResult result);

  // Keep the renderer-facing ipcRenderer.sendSync semantics, but do not make
  // the Browser -> Utility hop synchronous. The Utility main isolate may call
  // a native window API that sends a message back to the Browser UI thread;
  // making both hops synchronous deadlocks those two threads.
  ElectronIpcSendSync(string container_id,
                      string endpoint_id,
                      string channel,
                      mojo_base.mojom.Value arguments)
      => (xenon.ipc.mojom.IpcResult result);

  // N-API / Node Addon testing methods (runs in the utility process)
  [Sync]
  LoadAddon(string context_id, string path)
      => (bool success, string error_msg, array<NodeExportInfo> exports);

  // Expand one export path (e.g. "NativeAplayerStack") one level deeper.
  // For napi_define_class exports, children come from Constructor.prototype
  // (inspection only; invoke uses ConstructExport + InvokeInstance).
  InspectExport(string context_id, string module_path, string export_path)
      => (bool success, string error_msg, NodeExportInfo? info);

  // `new Constructor(...args)` in the Utility isolate; returns an instance id.
  // Marked [Sync] so Browser can preserve Electron constructor semantics for
  // renderer code that does not pass JavaScript callbacks.
  [Sync]
  ConstructExport(string context_id,
                  int32 client_id,
                  string module_path,
                  string export_path,
                  array<NodeInvokeArg> args)
      => (bool success, int32 instance_id, string error_msg);

  // Call an instance method with `this` = the constructed object (V8 walks
  // the prototype chain for the method lookup). Marked [Sync] so Browser can
  // return native handles without wrapping them in a Promise.
  [Sync]
  InvokeInstance(string context_id,
                 int32 client_id,
                 string module_path,
                 int32 instance_id,
                 string method_name,
                 array<NodeInvokeArg> args)
      => (bool success,
          mojo_base.mojom.Value result,
          array<NodeCallbackResult> callback_results,
          string error_msg);

  GetInstanceProperty(
      string context_id,
      string module_path,
      int32 instance_id,
      string property_name)
      => (bool success, mojo_base.mojom.Value result, string error_msg);

  SetInstanceProperty(string context_id,
                      string module_path,
                      int32 instance_id,
                      string property_name,
                      mojo_base.mojom.Value value)
      => (bool success, string error_msg);

  ReleaseInstance(string context_id, string module_path, int32 instance_id);

  [Sync]
  InvokeFunction(string context_id,
                 int32 client_id,
                 string module_path,
                 string function_name,
                 array<NodeInvokeArg> args)
      => (bool success,
          mojo_base.mojom.Value result,
          array<NodeCallbackResult> callback_results,
          string error_msg);

  GetExportProperty(
      string context_id,
      string module_path,
      string object_path,
      string property_name)
      => (bool success, mojo_base.mojom.Value result, string error_msg);

  SetExportProperty(string context_id,
                    string module_path,
                    string object_path,
                    string property_name,
                    mojo_base.mojom.Value value)
      => (bool success, string error_msg);

  // Batch several invokes in one Mojo round-trip (same module).
  InvokeMany(string context_id,
             string module_path,
             array<NodeInvokeCall> calls)
      => (array<NodeInvokeCallResult> results);
};
