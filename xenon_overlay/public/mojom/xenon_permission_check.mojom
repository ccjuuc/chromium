module xenon.ipc.mojom;

import "mojo/public/mojom/base/values.mojom";

// A dedicated pipe for the synchronous Electron permission-check callback.
// The Browser may close this pipe from an independent sequence when a callback
// exceeds its deadline, without closing the application's main service pipe.
interface ElectronPermissionCheck {
  [Sync]
  Check(mojo_base.mojom.Value request) => (bool granted, string error);
};
