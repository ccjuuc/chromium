module xenon.mojom;

import "mojo/public/mojom/base/values.mojom";

interface XenonToolExecutor {
  Execute(string input_json) => (string? result);
};

// Document-scoped host for the renderer `window.xenon` binding (BrowserInterfaceBroker).
interface XenonPageHost {
  // Round-trip to the browser process; `ok` false means the host declined or failed.
  Ping() => (bool ok, string message);

  // Semantic version string for the page API surface (not Chrome version).
  GetApiVersion() => (string version);

  // JSON-like object round-trip (maps to `base::Value`; renderer uses V8ValueConverter).
  EchoObject(mojo_base.mojom.Value input) => (mojo_base.mojom.Value output);

  // Wraps `input` as `{"payload": input, "browser_routing_id": N}` for demo metadata.
  WrapObjectWithBrowserMeta(mojo_base.mojom.Value input) =>
      (mojo_base.mojom.Value output);

  // Registers a tool with the browser process.
  RegisterTool(string name, string description, string input_schema, pending_remote<XenonToolExecutor> executor) => (bool success);
};
