  deps = [
    ":xenon_prefs",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/background/extensions",
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/ui",
    "//chrome/browser/ui/startup",
