if (is_mac) {
  source_set("xenon_update_mac_privileged_util") {
    sources = [
      "updater/xenon_update_mac_privileged_generation.h",
      "updater/xenon_update_mac_privileged_generation.mm",
      "updater/xenon_update_mac_privileged_protocol.h",
      "updater/xenon_update_mac_privileged_util.h",
      "updater/xenon_update_mac_privileged_util.mm",
    ]
    frameworks = [
      "Foundation.framework",
      "Security.framework",
    ]
  }

  source_set("xenon_update_mac_privileged_client") {
    sources = [
      "updater/xenon_update_mac_privileged_client.h",
      "updater/xenon_update_mac_privileged_client.mm",
    ]
    public_deps = [ ":xenon_update_mac_privileged_util" ]
    frameworks = [
      "AppKit.framework",
      "Foundation.framework",
      "Security.framework",
      "ServiceManagement.framework",
    ]
  }

  source_set("xenon_update_mac_util") {
    sources = [
      "updater/xenon_update_mac_util.h",
      "updater/xenon_update_mac_util.mm",
    ]
    frameworks = [
      "Foundation.framework",
      "Security.framework",
    ]
  }

  executable("xenon_update_helper") {
    sources = [ "updater/xenon_update_mac_helper.mm" ]
    deps = [
      ":xenon_update_mac_privileged_client",
      ":xenon_update_mac_util",
    ]
    frameworks = [ "AppKit.framework" ]
  }

  bundle_data("xenon_update_helper_bundle_data") {
    sources = [ "$root_out_dir/xenon_update_helper" ]
    outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
    public_deps = [ ":xenon_update_helper" ]
  }

  # The privileged process contains only the narrow native update service.
  # Browser/renderer and GUI dependencies belong in the unprivileged client.
  executable("xenon_privileged_update_helper") {
    sources = [ "updater/xenon_update_mac_privileged_service.mm" ]
    deps = [ ":xenon_update_mac_privileged_util" ]
    frameworks = [
      "Foundation.framework",
      "Security.framework",
    ]
  }

  bundle_data("xenon_privileged_update_helper_bundle_data") {
    sources = [ "$root_out_dir/xenon_privileged_update_helper" ]
    outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
    public_deps = [ ":xenon_privileged_update_helper" ]
  }

  bundle_data("xenon_privileged_update_launchd_bundle_data") {
    sources = [ "updater/com.xl153.updater.privileged.plist" ]
    outputs =
        [ "{{bundle_contents_dir}}/Library/LaunchDaemons/{{source_file_part}}" ]
  }
}

