if (enable_xenon_service) {
  source_set("unit_tests") {
    testonly = true
    sources = [ "xenon_manager_unittest.cc" ]
    deps = [
      ":browser",
      "//base/test:test_support",
      "//testing/gtest",
    ]
  }
}
