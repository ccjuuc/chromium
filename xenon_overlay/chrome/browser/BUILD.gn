if (enable_xenon_node_uv_compat && !is_win) {
  source_set("napi_node_exports") {
    sources = [
      "napi/js_native_api_v8.cc",
      "napi/js_native_api_v8.h",
    ]
    include_dirs = [ "napi" ]
    deps = [
      "//base",
      "//v8",
      "//xenon_overlay/buildflags",
      "//xenon_overlay/third_party:libuv",
    ]
  }
}

if (is_win) {
  if (enable_xenon_node_uv_compat) {
    node_forwarders_def = "$target_gen_dir/napi_node_forwarders.def"
    action("generate_napi_node_forwarders") {
      script = "napi/generate_node_forwarders.py"
      inputs = [
        "napi/js_native_api.h",
        "napi/js_native_api_v8.h",
        "napi/node_api.h",
        "//xenon_overlay/third_party/libuv/include/uv.h",
      ]
      outputs = [ node_forwarders_def ]
      args = [
               "--output",
               rebase_path(node_forwarders_def, root_build_dir),
             ] + rebase_path(inputs, root_build_dir)
    }

    shared_library("node") {
      sources = [
        "napi/node_forwarder_stub.cc",
        node_forwarders_def,
      ]
      deps = [ ":generate_napi_node_forwarders" ]
    }

    shared_library("node_exe") {
      output_name = "node"
      output_extension = "exe"
      sources = [
        "napi/node_forwarder_stub.cc",
        node_forwarders_def,
      ]
      deps = [ ":generate_napi_node_forwarders" ]
    }
  } else {
    shared_library("node") {
      sources = [
        "napi/js_native_api_v8.cc",
        "napi/js_native_api_v8.h",
      ]
      include_dirs = [ "napi" ]
      deps = [
        "//base",
        "//v8",
        "//xenon_overlay/buildflags",
      ]
    }
  }
}

shared_library("test_addon") {
  output_extension = "node"
  output_prefix_override = true
  sources = [ "napi/test_addon/test_addon.cc" ]
  include_dirs = [ "napi" ]
  deps = [ "//base" ]
  if (enable_xenon_node_uv_compat) {
    defines = [ "XENON_TEST_UV_COMPAT" ]
    include_dirs += [ "//xenon_overlay/third_party/libuv/include" ]
  }
  if (is_win) {
    if (enable_xenon_node_uv_compat) {
      sources += [ "napi/test_addon/win_delay_load_hook.cc" ]
      deps += [ ":node_exe" ]
      ldflags = [ "/DELAYLOAD:node.exe" ]
    } else {
      deps += [ ":node" ]
    }
  } else {
    configs -= [ "//build/config/compiler:no_unresolved_symbols" ]
    if (is_mac) {
      ldflags = [ "-Wl,-undefined,dynamic_lookup" ]
    }
  }
}

