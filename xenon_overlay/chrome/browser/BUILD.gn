    "xenon_prefs.cc",
    "xenon_prefs.h",
  ]
  deps = [
    "//components/pref_registry",
    "//components/prefs",
  ]
}

source_set("xenon_common_bubble") {
  sources = [
    "ui/xenon_common_bubble.cc",
    "ui/xenon_common_bubble.h",
  ]

  deps = [
    "//base",
    "//cc/paint",
