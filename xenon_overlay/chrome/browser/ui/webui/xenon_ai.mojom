module xenon.mojom;

// Browser-side handler for requests from Xenon AI side panel.
interface XenonAiPageHandler {
  // Sets the page remote for callbacks from browser to UI.
  SetPage(pending_remote<XenonAiPage> page);

  // Returns the initial prompt to display in the UI.
  GetInitialPrompt() => (string prompt);
};

// UI-side handler for messages from the browser process.
interface XenonAiPage {
  // Notifies the UI that a new prompt has been received (e.g. from context menu).
  OnPromptReceived(string prompt);
};
