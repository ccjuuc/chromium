import("//xenon_overlay/buildflags/features.gni")

if (enable_xenon_ai) {
  source_set("xenon_ai") {
    sources = [
      "browser_context_keyed_service_factories.cc",
      "browser_context_keyed_service_factories.h",
      "../ui/webui/xenon_ai/xenon_ai_side_panel_ui.cc",
      "../ui/webui/xenon_ai/xenon_ai_side_panel_ui.h",
      "xenon_ai_service.cc",
      "xenon_ai_service.h",
      "xenon_ai_service_factory.cc",
      "xenon_ai_service_factory.h",
    ]

    deps = [
      "//base",
      "//chrome/browser/profiles",
      "//chrome/browser/ui/webui/top_chrome",
      "//chrome/common",
      "//components/keyed_service/core",
      "//content/public/browser",
      "//xenon_overlay/buildflags",
      "//xenon_overlay/resources:resources_grit",
    ]

    public_deps = [ "//chrome/browser/profiles:profile" ]
  }
}
