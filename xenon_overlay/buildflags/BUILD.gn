import("//build/buildflag_header.gni")
import("//chrome/version.gni")
import("//xenon_overlay/buildflags/features.gni")

xenon_extension_source_zip = xenon_extension_source == "zip"

assert(xenon_crash_upload_format == "multipart" ||
       xenon_crash_upload_format == "binary")
xenon_crash_upload_binary = xenon_crash_upload_format == "binary"

buildflag_header("crash_buildflags") {
  header = "crash_buildflags.h"
  flags = [
    "XENON_CRASH_UPLOAD_URL=\"$xenon_crash_upload_url\"",
    "XENON_CRASH_UPLOAD_ENABLED=$xenon_crash_upload_enabled",
    "XENON_CRASH_UPLOAD_BINARY=$xenon_crash_upload_binary",
  ]
}

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "ENABLE_XENON_SERVICE=$enable_xenon_service",
    "ENABLE_XENON_MANAGER_SHARED_REMOTE=$enable_xenon_manager_shared_remote",
    "ENABLE_XENON_ASSOCIATED_SIDE=$enable_xenon_associated_side",
    "ENABLE_XENON_BROWSER_OBSERVER=$enable_xenon_browser_observer",
    "ENABLE_XENON_AI=$enable_xenon_ai",
    "ENABLE_XENON_NODE_UV_COMPAT=$enable_xenon_node_uv_compat",
    "ENABLE_XENON_LOGIN_GATE=$enable_xenon_login_gate",
    "XENON_EXTENSION_SOURCE_ZIP=$xenon_extension_source_zip",
  ]
}

# Compiler defines for custom binary / product naming. Prefer these configs
# over inlining chrome_custom_*_defines in each target.
config("custom_names") {
  defines = chrome_custom_names_defines
}

config("custom_install_identity") {
  defines = chrome_custom_install_identity_defines
}

config("custom_win") {
  defines = chrome_custom_win_defines
}
