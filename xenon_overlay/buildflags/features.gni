declare_args() {
  for_xl = true

  # Xenon Overlay Service is enabled on Windows, Linux, and Mac.
  # ChromeOS and Android are not currently supported targets for this overlay.
  enable_xenon_service = is_win || is_linux || is_mac

  # When true, XenonManager binds XenonMainService with mojo::SharedRemote on the
  # UI thread so handles can be copied across sequences. When false, uses Remote.
  enable_xenon_manager_shared_remote = true

  # Associated interface XenonAssociatedSide (same pipe as XenonMainService).
  enable_xenon_associated_side = true

  # Utility→Browser XenonBrowserObserver + SetBrowserObserver registration.
  enable_xenon_browser_observer = true

  # Component extension source packaged into Xenon: "zip" for production, or
  # "directory" for plaintext development builds.
  xenon_extension_source = "zip"

  # Controls whether main browser window startup is gated behind the Xenon login dialog.
  enable_xenon_login_gate = false
}

# Second block: defaults may reference args from the block above (GN forbids same-block refs).
declare_args() {
  assert(
      xenon_extension_source == "zip" || xenon_extension_source == "directory")

  # Xenon AI: Profile KeyedService + chrome://xenon-ai-side-panel WebUI + Side Panel entry.
  enable_xenon_ai = enable_xenon_service

  # Enables Node/Electron-style compatibility exports backed by a statically
  # linked libuv for native addons on supported desktop platforms.
  enable_xenon_node_uv_compat =
      (is_win || is_mac || is_linux) && enable_xenon_service

  # Cargo-built xenon_ai_inferencer_burn (GN action → $root_out_dir) via
  # tools/crates/run_cargo.py + //third_party/rust-toolchain. Set false to skip
  # the action (copy a sidecar into out/ manually if needed).
  build_xenon_ai_inferencer_burn = true

  # When true, pass --no-default-features --features backend_ndarray (CPU; smaller binary).
  xenon_ai_inferencer_burn_cpu_only = false
}

# Product / binary naming (consumed by //chrome/version.gni).
declare_args() {
  # Custom executable basename. Empty defaults to "chrome".
  custom_exe_name = ""

  # Custom chrome dll basename on Windows. Empty defaults to "chrome". Mac
  # framework names follow the product name.
  custom_dll_name = ""

  # Append version to exe/dll filenames. Mac app/framework names never get a
  # version suffix.
  use_version_in_filenames = false

  # Display/package version (MAJOR.MINOR.BUILD.PATCH). Does not overwrite
  # chrome_version_* used by Chromium internals.
  custom_version_string = ""

  # Display / install product name. Empty derives from custom_exe_name, or
  # "Chromium" when neither is set. AppId / ProgIDs / registry path are derived.
  custom_product_name = ""
}
