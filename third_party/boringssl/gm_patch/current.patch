+TEST(SSLTest, GMProtocolTLCPClientHelloExtensionsAndResumption) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  // Chromium's ordinary TLS defaults must not leak TLS-only extensions or
+  // GREASE into this separate, fixed-SM2 TLCP profile.
+  SSL_CTX_set_grease_enabled(ctx.get(), 1);
+  SSL_CTX_set_permute_extensions(ctx.get(), 1);
+  SSL_CTX_enable_ocsp_stapling(ctx.get());
+  SSL_CTX_enable_signed_cert_timestamps(ctx.get());
+  enum { kNoTicket, kRequestTicket, kResumeTicket, kResumeID };
+  for (int mode : {kNoTicket, kRequestTicket, kResumeTicket, kResumeID}) {
+    SCOPED_TRACE(mode);
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    ASSERT_TRUE(SSL_set_gm_mode(ssl.get(), SSL_GM_MODE_TLCP));
+    SSL_set_custom_verify(ssl.get(), SSL_VERIFY_PEER,
+                          [](SSL *, uint8_t *) { return ssl_verify_ok; });
+    // A large ClientHello also exercises the generic TLS padding path.
+    const std::string hostname = std::string(60, 'a') + "." +
+                                 std::string(60, 'b') + "." +
+                                 std::string(60, 'c') + ".test";
+    ASSERT_TRUE(SSL_set_tlsext_host_name(ssl.get(), hostname.c_str()));
+    static const uint8_t kALPN[] = {8, 'h', 't', 't', 'p', '/', '1', '.', '1'};
+    ASSERT_EQ(SSL_set_alpn_protos(ssl.get(), kALPN, sizeof(kALPN)), 0);
+    if (mode == kNoTicket || mode == kResumeID) {
+      SSL_set_options(ssl.get(), SSL_OP_NO_TICKET);
+    }
+    UniquePtr<SSL_SESSION> session;
+    static const uint8_t kSessionID[] = {1, 2, 3, 4};
+    if (mode == kResumeTicket || mode == kResumeID) {
+      session = CreateSessionWithTicket(TLCP1_1_VERSION,
+                                        mode == kResumeTicket ? 8 : 0);
+      ASSERT_TRUE(session);
+      session->cipher =
+          SSL_get_cipher_by_value(SSL_CIPHER_TLCP_ECC_SM4_GCM_SM3);
+      ASSERT_TRUE(
+          SSL_SESSION_set1_id(session.get(), kSessionID, sizeof(kSessionID)));
+      ASSERT_TRUE(SSL_set_session(ssl.get(), session.get()));
+    }
+    std::vector<uint8_t> hello;
+    ASSERT_TRUE(GetClientHello(ssl.get(), &hello));
+    CBS record(hello), handshake, body, session_id, suites, compression,
+        extensions;
+    ASSERT_TRUE(CBS_skip(&record, 3));
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&record, &handshake));
+    ASSERT_TRUE(CBS_skip(&handshake, 1));
+    ASSERT_TRUE(CBS_get_u24_length_prefixed(&handshake, &body));
+    ASSERT_TRUE(CBS_skip(&body, 2 + SSL3_RANDOM_SIZE));
+    ASSERT_TRUE(CBS_get_u8_length_prefixed(&body, &session_id));
+    if (mode == kResumeID) {
+      EXPECT_EQ(Bytes(session_id), Bytes(kSessionID));
+    } else if (mode == kResumeTicket) {
+      EXPECT_EQ(CBS_len(&session_id), SSL_MAX_SSL_SESSION_ID_LENGTH);
+    } else {
+      EXPECT_EQ(CBS_len(&session_id), 0u);
+    }
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&body, &suites));
+    ASSERT_TRUE(CBS_get_u8_length_prefixed(&body, &compression));
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&body, &extensions));
+    std::vector<uint16_t> extension_types;
+    while (CBS_len(&extensions) != 0) {
+      uint16_t type;
+      CBS contents;
+      ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+      ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &contents));
+      extension_types.push_back(type);
+      if (type == TLSEXT_TYPE_supported_groups) {
+        // Only the actual fixed-SM2 group is advertised, even with GREASE on.
+        const uint8_t kGroups[] = {0, 2, 0, SSL_GROUP_SM2};
+        EXPECT_EQ(Bytes(contents), Bytes(kGroups));
+      } else if (type == TLSEXT_TYPE_session_ticket) {
+        EXPECT_EQ(Bytes(contents),
+                  Bytes(mode == kResumeTicket ? "aaaaaaaa" : ""));
+      }
+    }
+    std::sort(extension_types.begin(), extension_types.end());
+    std::vector<uint16_t> expected = {
+        TLSEXT_TYPE_server_name, TLSEXT_TYPE_status_request,
+        TLSEXT_TYPE_supported_groups,
+        TLSEXT_TYPE_application_layer_protocol_negotiation};
+    if (mode == kRequestTicket || mode == kResumeTicket) {
+      expected.push_back(TLSEXT_TYPE_session_ticket);
+    }
+    std::sort(expected.begin(), expected.end());
+    EXPECT_EQ(extension_types, expected);
+  }
+}
