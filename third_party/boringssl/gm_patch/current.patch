+struct SM4GCMState {
+  SM4_KEY key;
+  u128 table[16];
+  gmult_func mult;
+  ghash_func hash;
+};
+
+static_assert(sizeof(SM4GCMState) <= sizeof(EVP_AEAD_CTX::state));
+static_assert(alignof(SM4GCMState) <= alignof(evp_aead_ctx_st_state));
+
+int SM4AEADInit(EVP_AEAD_CTX *ctx, const uint8_t *key, size_t key_len,
+                size_t tag_len) {
+  if (key_len != 16) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_KEY_LENGTH);
+    return 0;
+  }
+  if (tag_len != EVP_AEAD_DEFAULT_TAG_LENGTH && tag_len != 16) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TAG_TOO_LARGE);
+    return 0;
+  }
+  auto *state = reinterpret_cast<SM4GCMState *>(&ctx->state);
+  SM4_set_encrypt_key(key, &state->key);
+  ctx->tag_len = 16;
+  return 1;
+}
+
+int SM4GCMInit(EVP_AEAD_CTX *ctx, const uint8_t *key, size_t key_len,
+               size_t tag_len) {
+  if (!SM4AEADInit(ctx, key, key_len, tag_len)) {
+    return 0;
+  }
+  auto *state = reinterpret_cast<SM4GCMState *>(&ctx->state);
+  uint8_t h[16] = {0};
+  SM4_encrypt(h, h, &state->key);
+  CRYPTO_ghash_init(&state->mult, &state->hash, state->table, h);
+  OPENSSL_cleanse(h, sizeof(h));
+  return 1;
+}
+
+void SM4AEADCleanup(EVP_AEAD_CTX *ctx) {
+  OPENSSL_cleanse(&ctx->state, sizeof(ctx->state));
+}
+
+// GHash preserves partial blocks across vector boundaries. Padding is applied
+// only at the end of the AAD or ciphertext, never at an iovec boundary.
+class GHash {
+ public:
+  explicit GHash(const SM4GCMState *state) : state_(state) {}
+
+  void Update(const uint8_t *in, size_t len) {
+    while (len != 0) {
+      if (used_ == 0 && len >= 16) {
+        size_t whole = len & ~size_t{15};
+        state_->hash(xi_, state_->table, in, whole);
+        in += whole;
+        len -= whole;
+      } else {
+        xi_[used_++] ^= *in++;
+        len--;
+        if (used_ == 16) {
+          state_->mult(xi_, state_->table);
+          used_ = 0;
+        }
+      }
+    }
+  }
+
+  void Pad() {
+    if (used_ != 0) {
+      state_->mult(xi_, state_->table);
+      used_ = 0;
+    }
+  }
+
+  const uint8_t *value() const { return xi_; }
+
+ private:
+  const SM4GCMState *state_;
+  uint8_t xi_[16] = {0};
+  size_t used_ = 0;
+};
+
+bool GCMCheckLengths(Span<const CRYPTO_IOVEC> iovecs, Span<const uint8_t> nonce,
+                     Span<const CRYPTO_IVEC> aadvecs) {
+  if (nonce.size() != 12) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_UNSUPPORTED_NONCE_SIZE);
+    return false;
+  }
+  if (iovec::TotalLength(iovecs) > (uint64_t{1} << 36) - 32 ||
+      iovec::TotalLength(aadvecs) > UINT64_MAX / 8) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TOO_LARGE);
+    return false;
+  }
+  return true;
+}
+
+void GCMTag(const SM4GCMState *state, uint8_t tag[16],
+            Span<const CRYPTO_IOVEC> iovecs, Span<const uint8_t> nonce,
+            Span<const CRYPTO_IVEC> aadvecs, bool use_output) {
+  GHash hash(state);
+  for (const auto &v : aadvecs) {
+    hash.Update(v.in, v.len);
+  }
+  hash.Pad();
+  for (const auto &v : iovecs) {
+    hash.Update(use_output ? v.out : v.in, v.len);
+  }
+  hash.Pad();
+  uint8_t lengths[16];
+  CRYPTO_store_u64_be(lengths, uint64_t{iovec::TotalLength(aadvecs)} * 8);
+  CRYPTO_store_u64_be(lengths + 8, uint64_t{iovec::TotalLength(iovecs)} * 8);
+  hash.Update(lengths, sizeof(lengths));
+  uint8_t j0[16] = {0};
+  OPENSSL_memcpy(j0, nonce.data(), 12);
+  j0[15] = 1;
+  SM4_encrypt(j0, tag, &state->key);
+  for (size_t i = 0; i < 16; i++) {
+    tag[i] ^= hash.value()[i];
+  }
+}
+
+void GCMCrypt(const SM4_KEY *key, Span<const CRYPTO_IOVEC> iovecs,
+              Span<const uint8_t> nonce) {
+  uint8_t counter[16] = {0}, stream[16];
+  OPENSSL_memcpy(counter, nonce.data(), 12);
+  counter[15] = 2;
+  size_t used = 0;
+  for (const auto &v : iovecs) {
+    SM4CTRBytes(key, v.out, v.in, v.len, counter, 12, stream, &used);
+  }
+  OPENSSL_cleanse(stream, sizeof(stream));
+}
+
+int SM4GCMSeal(const EVP_AEAD_CTX *ctx, Span<const CRYPTO_IOVEC> iovecs,
+               Span<uint8_t> out_tag, size_t *out_tag_len,
+               Span<const uint8_t> nonce, Span<const CRYPTO_IVEC> aadvecs) {
+  if (!GCMCheckLengths(iovecs, nonce, aadvecs)) {
+    return 0;
+  }
+  if (out_tag.size() < 16) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BUFFER_TOO_SMALL);
+    return 0;
+  }
+  const auto *state = reinterpret_cast<const SM4GCMState *>(&ctx->state);
+  GCMCrypt(&state->key, iovecs, nonce);
+  GCMTag(state, out_tag.data(), iovecs, nonce, aadvecs, true);
+  *out_tag_len = 16;
+  return 1;
+}
+
+int SM4GCMOpen(const EVP_AEAD_CTX *ctx, Span<const CRYPTO_IOVEC> iovecs,
+               Span<const uint8_t> nonce, Span<const uint8_t> tag,
+               Span<const CRYPTO_IVEC> aadvecs) {
+  if (!GCMCheckLengths(iovecs, nonce, aadvecs)) {
+    return 0;
+  }
+  const auto *state = reinterpret_cast<const SM4GCMState *>(&ctx->state);
+  uint8_t expected[16];
+  GCMTag(state, expected, iovecs, nonce, aadvecs, false);
+  if (tag.size() != 16 || CRYPTO_memcmp(expected, tag.data(), 16) != 0) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_DECRYPT);
+    return 0;
+  }
+  GCMCrypt(&state->key, iovecs, nonce);
+  return 1;
+}
+
+class CCMMac {
+ public:
+  explicit CCMMac(const SM4_KEY *key) : key_(key) {}
+
+  void Update(const uint8_t *data, size_t len) {
+    for (size_t i = 0; i < len; i++) {
+      state_[used_++] ^= data[i];
+      if (used_ == 16) {
+        SM4_encrypt(state_, state_, key_);
+        used_ = 0;
+      }
+    }
+  }
+
+  void Pad() {
+    if (used_ != 0) {
+      SM4_encrypt(state_, state_, key_);
+      used_ = 0;
+    }
+  }
+
+  const uint8_t *value() const { return state_; }
+
+ private:
+  const SM4_KEY *key_;
+  uint8_t state_[16] = {0};
+  size_t used_ = 0;
+};
+
+// RFC 8998 specifies CCM with M=16 and L=3. This is SP 800-38C's formatting
+// and CBC-MAC, with the SM4 block permutation substituted for AES.
+int CCMCrypt(const EVP_AEAD_CTX *ctx, Span<const CRYPTO_IOVEC> iovecs,
+             Span<const uint8_t> nonce, Span<const CRYPTO_IVEC> aadvecs,
+             bool decrypt, uint8_t tag[16]) {
+  if (nonce.size() != 12) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_UNSUPPORTED_NONCE_SIZE);
+    return 0;
+  }
+  size_t len = iovec::TotalLength(iovecs);
+  if (len >= (uint64_t{1} << 24)) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TOO_LARGE);
+    return 0;
+  }
+  const auto *state = reinterpret_cast<const SM4GCMState *>(&ctx->state);
+  CCMMac mac(&state->key);
+  size_t aad_len = iovec::TotalLength(aadvecs);
+  uint8_t b0[16] = {0};
+  b0[0] = (aad_len != 0 ? 0x40 : 0) | (7 << 3) | 2;
+  OPENSSL_memcpy(b0 + 1, nonce.data(), 12);
+  b0[13] = static_cast<uint8_t>(len >> 16);
+  b0[14] = static_cast<uint8_t>(len >> 8);
+  b0[15] = static_cast<uint8_t>(len);
+  mac.Update(b0, sizeof(b0));
+  if (aad_len != 0) {
+    uint8_t encoded[10];
+    size_t encoded_len;
+    if (aad_len < 0xff00) {
+      CRYPTO_store_u16_be(encoded, static_cast<uint16_t>(aad_len));
+      encoded_len = 2;
+    } else if (aad_len <= UINT32_MAX) {
+      encoded[0] = 0xff;
+      encoded[1] = 0xfe;
+      CRYPTO_store_u32_be(encoded + 2, static_cast<uint32_t>(aad_len));
+      encoded_len = 6;
+    } else {
+      encoded[0] = encoded[1] = 0xff;
+      CRYPTO_store_u64_be(encoded + 2, aad_len);
+      encoded_len = 10;
+    }
+    mac.Update(encoded, encoded_len);
+    for (const auto &v : aadvecs) {
+      mac.Update(v.in, v.len);
+    }
+    mac.Pad();
+  }
+  uint8_t counter[16] = {2}, stream[16];
+  OPENSSL_memcpy(counter + 1, nonce.data(), 12);
+  SM4_encrypt(counter, tag, &state->key);
+  counter[15] = 1;
+  size_t used = 0;
+  for (const auto &v : iovecs) {
+    // CBC-MAC remains serial. Read plaintext before an in-place encryption
+    // overwrites it, or after decryption produces it.
+    if (!decrypt) {
+      mac.Update(v.in, v.len);
+    }
+    SM4CTRBytes(&state->key, v.out, v.in, v.len, counter, 13, stream, &used);
+    if (decrypt) {
+      mac.Update(v.out, v.len);
+    }
+  }
+  mac.Pad();
+  for (size_t i = 0; i < 16; i++) {
+    tag[i] ^= mac.value()[i];
+  }
+  OPENSSL_cleanse(stream, sizeof(stream));
+  return 1;
+}
+
+int SM4CCMSeal(const EVP_AEAD_CTX *ctx, Span<const CRYPTO_IOVEC> iovecs,
+               Span<uint8_t> out_tag, size_t *out_tag_len,
+               Span<const uint8_t> nonce, Span<const CRYPTO_IVEC> aadvecs) {
+  if (out_tag.size() < 16) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BUFFER_TOO_SMALL);
+    return 0;
+  }
+  if (!CCMCrypt(ctx, iovecs, nonce, aadvecs, false, out_tag.data())) {
+    return 0;
+  }
+  *out_tag_len = 16;
+  return 1;
+}
+
+int SM4CCMOpen(const EVP_AEAD_CTX *ctx, Span<const CRYPTO_IOVEC> iovecs,
+               Span<const uint8_t> nonce, Span<const uint8_t> tag,
+               Span<const CRYPTO_IVEC> aadvecs) {
+  if (tag.size() != 16) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_DECRYPT);
+    return 0;
+  }
+  uint8_t expected[16];
+  if (!CCMCrypt(ctx, iovecs, nonce, aadvecs, true, expected)) {
+    return 0;
+  }
+  if (CRYPTO_memcmp(expected, tag.data(), 16) != 0) {
+    // The common EVP_AEAD wrapper clears all output on authentication failure.
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_DECRYPT);
+    return 0;
+  }
+  return 1;
+}
+
+const EVP_AEAD kSM4GCM = {
+    16,
+    12,
+    16,
+    16,
+    SM4GCMInit,
+    nullptr,
+    SM4AEADCleanup,
+    nullptr,
+    SM4GCMSeal,
+    SM4GCMOpen,
+    nullptr,
+    nullptr,
+};
+
+const EVP_AEAD kSM4CCM = {
+    16,
+    12,
+    16,
+    16,
+    SM4AEADInit,
+    nullptr,
+    SM4AEADCleanup,
+    nullptr,
+    SM4CCMSeal,
+    SM4CCMOpen,
+    nullptr,
+    nullptr,
+};
+
+}  // namespace
+
+const EVP_CIPHER *EVP_sm4_cbc() { return &kSM4CBC; }
+const EVP_CIPHER *EVP_sm4_ctr() { return &kSM4CTR; }
+const EVP_AEAD *EVP_aead_sm4_gcm() { return &kSM4GCM; }
+const EVP_AEAD *EVP_aead_sm4_ccm() { return &kSM4CCM; }
+
+#else
+
+const EVP_CIPHER *EVP_sm4_cbc() { return nullptr; }
+const EVP_CIPHER *EVP_sm4_ctr() { return nullptr; }
+const EVP_AEAD *EVP_aead_sm4_gcm() { return nullptr; }
+const EVP_AEAD *EVP_aead_sm4_ccm() { return nullptr; }
+#endif  // XENON_GM
