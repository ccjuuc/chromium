+TEST(SM2Test, EVPDefaultIdentityAndKeyEncoding) {
+  auto ec = StandardKey();
+  ASSERT_TRUE(ec);
+  bssl::UniquePtr<EVP_PKEY> key(EVP_PKEY_new());
+  ASSERT_TRUE(key);
+  ASSERT_TRUE(EVP_PKEY_set1_EC_KEY(key.get(), ec.get()));
+  bssl::ScopedEVP_MD_CTX ctx;
+  ASSERT_TRUE(
+      EVP_DigestSignInit(ctx.get(), nullptr, EVP_sm3(), nullptr, key.get()));
+  uint8_t signature[72];
+  size_t length = sizeof(signature);
+  ASSERT_TRUE(EVP_DigestSign(ctx.get(), signature, &length, kMessage,
+                             sizeof(kMessage) - 1));
+  uint8_t digest[32];
+  ASSERT_TRUE(SM2_compute_digest(digest, ec.get(), kID, sizeof(kID) - 1,
+                                 kMessage, sizeof(kMessage) - 1));
+  EXPECT_TRUE(SM2_verify_digest(digest, signature, length, ec.get()));
+  ASSERT_TRUE(
+      EVP_DigestVerifyInit(ctx.get(), nullptr, EVP_sm3(), nullptr, key.get()));
+  EXPECT_TRUE(EVP_DigestVerify(ctx.get(), signature, length, kMessage,
+                               sizeof(kMessage) - 1));
+  ASSERT_TRUE(
+      EVP_DigestSignInit(ctx.get(), nullptr, EVP_sm3(), nullptr, key.get()));
+  ASSERT_TRUE(EVP_DigestSignUpdate(ctx.get(), kMessage, 4));
+  ASSERT_TRUE(
+      EVP_DigestSignUpdate(ctx.get(), kMessage + 4, sizeof(kMessage) - 1 - 4));
+  length = sizeof(signature);
+  ASSERT_TRUE(EVP_DigestSignFinal(ctx.get(), signature, &length));
+  EXPECT_TRUE(SM2_verify_digest(digest, signature, length, ec.get()));
+  EXPECT_FALSE(
+      EVP_DigestSignInit(ctx.get(), nullptr, EVP_sha256(), nullptr, key.get()));
+  ERR_clear_error();
+
+  for (bool private_key : {false, true}) {
+    bssl::ScopedCBB cbb;
+    ASSERT_TRUE(CBB_init(cbb.get(), 128));
+    ASSERT_TRUE(private_key ? EVP_marshal_private_key(cbb.get(), key.get())
+                            : EVP_marshal_public_key(cbb.get(), key.get()));
+    CBS cbs;
+    CBS_init(&cbs, CBB_data(cbb.get()), CBB_len(cbb.get()));
+    bssl::UniquePtr<EVP_PKEY> parsed(private_key ? EVP_parse_private_key(&cbs)
+                                                 : EVP_parse_public_key(&cbs));
+    ASSERT_TRUE(parsed);
+    EXPECT_EQ(0u, CBS_len(&cbs));
+    EXPECT_EQ(EVP_PKEY_EC, EVP_PKEY_id(parsed.get()));
+    EXPECT_EQ(NID_sm2, EC_GROUP_get_curve_name(EC_KEY_get0_group(
+                           EVP_PKEY_get0_EC_KEY(parsed.get()))));
+    EXPECT_EQ(1, EVP_PKEY_cmp(key.get(), parsed.get()));
+  }
+}
