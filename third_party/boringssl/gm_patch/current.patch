+TEST(SM2Test, RejectPrivateScalarMinusOne) {
+  auto key = StandardKey();
+  ASSERT_TRUE(key);
+  bssl::UniquePtr<BIGNUM> private_key(
+      BN_dup(EC_GROUP_get0_order(EC_group_sm2())));
+  ASSERT_TRUE(private_key);
+  ASSERT_TRUE(BN_sub_word(private_key.get(), 1));
+  ASSERT_TRUE(EC_KEY_set_private_key(key.get(), private_key.get()));
+  uint8_t digest[32] = {}, signature[72];
+  size_t length;
+  EXPECT_FALSE(SM2_sign_digest(digest, signature, &length, sizeof(signature),
+                               key.get()));
+}
