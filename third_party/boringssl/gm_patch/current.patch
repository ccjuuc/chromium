+  ERR_clear_error();
+  EXPECT_EQ(nullptr, EVP_pkey_ec_sm2());
+  uint8_t digest[SM2_DIGEST_LENGTH] = {};
+  uint8_t signature[80] = {};
+  size_t length = 0;
+  EXPECT_FALSE(SM2_compute_z_digest(digest, nullptr, nullptr, 0));
+  EXPECT_FALSE(SM2_compute_digest(digest, nullptr, nullptr, 0, nullptr, 0));
+  EXPECT_FALSE(
+      SM2_sign_digest(digest, signature, &length, sizeof(signature), nullptr));
+  EXPECT_FALSE(
+      SM2_verify_digest(digest, signature, sizeof(signature), nullptr));
+  EXPECT_FALSE(SM2_encrypt(signature, &length, sizeof(signature), digest,
+                           sizeof(digest), nullptr));
+  EXPECT_FALSE(SM2_decrypt(signature, &length, sizeof(signature), digest,
+                           sizeof(digest), nullptr));
+}
