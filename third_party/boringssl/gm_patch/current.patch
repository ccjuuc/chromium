+TEST(SM2Test, EncryptRoundTripAndBufferBounds) {
+  auto key = StandardKey();
+  ASSERT_TRUE(key);
+  size_t length;
+  ASSERT_TRUE(
+      SM2_encrypt(nullptr, &length, 0, kMessage, sizeof(kMessage), key.get()));
+  std::vector<uint8_t> ciphertext(length);
+  ASSERT_TRUE(SM2_encrypt(ciphertext.data(), &length, ciphertext.size(),
+                          kMessage, sizeof(kMessage), key.get()));
+  ciphertext.resize(length);
+  uint8_t plaintext[sizeof(kMessage)];
+  EXPECT_FALSE(SM2_decrypt(plaintext, &length, sizeof(plaintext) - 1,
+                           ciphertext.data(), ciphertext.size(), key.get()));
+  ASSERT_TRUE(SM2_decrypt(plaintext, &length, sizeof(plaintext),
+                          ciphertext.data(), ciphertext.size(), key.get()));
+  EXPECT_EQ(Bytes(kMessage, sizeof(kMessage)), Bytes(plaintext, length));
+  ciphertext.push_back(0);
+  EXPECT_FALSE(SM2_decrypt(plaintext, &length, sizeof(plaintext),
+                           ciphertext.data(), ciphertext.size(), key.get()));
+  EXPECT_FALSE(SM2_encrypt(nullptr, &length, 0, nullptr, SIZE_MAX, key.get()));
+  EXPECT_FALSE(SM2_encrypt(nullptr, &length, 0, nullptr, 0, key.get()));
+  ERR_clear_error();
+}
