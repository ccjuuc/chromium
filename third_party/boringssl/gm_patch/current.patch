+      !SSL_CTX_set_chain_and_key(ctx.get(), chain, 1, key.get(), nullptr)) {
+    return nullptr;
+  }
+  return ctx;
+}
+
+struct GMClientFlightObserver {
+  size_t client_hellos = 0;
+  size_t certificates = 0;
+  std::vector<size_t> ccs_after_client_hellos;
+
+  void Install(SSL *ssl) {
+    SSL_set_msg_callback_arg(ssl, this);
+    SSL_set_msg_callback(ssl, [](int is_write, int, int type, const void *buf,
+                                 size_t len, SSL *, void *arg) {
+      if (!is_write || len == 0) {
+        return;
+      }
+      auto *self = static_cast<GMClientFlightObserver *>(arg);
+      const auto *bytes = static_cast<const uint8_t *>(buf);
+      if (type == SSL3_RT_CHANGE_CIPHER_SPEC) {
+        self->ccs_after_client_hellos.push_back(self->client_hellos);
+      } else if (type == SSL3_RT_HANDSHAKE) {
+        self->client_hellos += bytes[0] == SSL3_MT_CLIENT_HELLO;
+        self->certificates += bytes[0] == SSL3_MT_CERTIFICATE;
+      }
+    });
+  }
+};
