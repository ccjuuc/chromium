+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include <openssl/sm3.h>
+
+#include <stdlib.h>
+
+#include <openssl/mem.h>
+#include <openssl/span.h>
+
+#include "../fipsmodule/digest/md32_common.h"
+#include "../internal.h"
+
+#if defined(XENON_GM)
+
+using namespace bssl;
+
+namespace {
+
+uint32_t Rotl(uint32_t x, unsigned n) {
+  n &= 31;
+  return (x << n) | (x >> ((32 - n) & 31));
+}
+
+uint32_t P0(uint32_t x) { return x ^ Rotl(x, 9) ^ Rotl(x, 17); }
+uint32_t P1(uint32_t x) { return x ^ Rotl(x, 15) ^ Rotl(x, 23); }
+
+struct SM3Traits {
+  using HashContext = SM3_CTX;
+  static constexpr size_t kBlockSize = SM3_CBLOCK;
+  static constexpr bool kLengthIsBigEndian = true;
+
+  static void HashBlocks(uint32_t *state, const uint8_t *data, size_t blocks) {
+    while (blocks-- != 0) {
+      uint32_t w[68];
+      for (size_t j = 0; j < 16; j++) {
+        w[j] = CRYPTO_load_u32_be(data + 4 * j);
+      }
+      for (size_t j = 16; j < 68; j++) {
+        w[j] = P1(w[j - 16] ^ w[j - 9] ^ Rotl(w[j - 3], 15)) ^
+               Rotl(w[j - 13], 7) ^ w[j - 6];
+      }
+      uint32_t a = state[0], b = state[1], c = state[2], d = state[3];
+      uint32_t e = state[4], f = state[5], g = state[6], h = state[7];
+      for (unsigned j = 0; j < 64; j++) {
+        uint32_t ss1 = Rotl(
+            Rotl(a, 12) + e + Rotl(j < 16 ? 0x79cc4519 : 0x7a879d8a, j), 7);
+        uint32_t ss2 = ss1 ^ Rotl(a, 12);
+        uint32_t ff = j < 16 ? a ^ b ^ c : (a & b) | (a & c) | (b & c);
+        uint32_t gg = j < 16 ? e ^ f ^ g : (e & f) | (~e & g);
+        uint32_t tt1 = ff + d + ss2 + (w[j] ^ w[j + 4]);
+        uint32_t tt2 = gg + h + ss1 + w[j];
+        d = c;
+        c = Rotl(b, 9);
+        b = a;
+        a = tt1;
+        h = g;
+        g = Rotl(f, 19);
+        f = e;
+        e = P0(tt2);
+      }
+      state[0] ^= a;
+      state[1] ^= b;
+      state[2] ^= c;
+      state[3] ^= d;
+      state[4] ^= e;
+      state[5] ^= f;
+      state[6] ^= g;
+      state[7] ^= h;
+      OPENSSL_cleanse(w, sizeof(w));
+      data += SM3_CBLOCK;
+    }
+  }
+};
+
+}  // namespace
+
+int SM3_Init(SM3_CTX *ctx) {
+  OPENSSL_memset(ctx, 0, sizeof(*ctx));
+  static const uint32_t kIV[8] = {0x7380166f, 0x4914b2b9, 0x172442d7,
+                                  0xda8a0600, 0xa96f30bc, 0x163138aa,
+                                  0xe38dee4d, 0xb0fb0e4e};
+  OPENSSL_memcpy(ctx->h, kIV, sizeof(kIV));
+  return 1;
+}
+
+int SM3_Update(SM3_CTX *ctx, const void *data, size_t len) {
+  crypto_md32_update<SM3Traits>(ctx,
+                                Span(static_cast<const uint8_t *>(data), len));
+  return 1;
+}
+
+int SM3_Final(uint8_t out[SM3_DIGEST_LENGTH], SM3_CTX *ctx) {
+  crypto_md32_final<SM3Traits>(ctx);
+  for (size_t i = 0; i < 8; i++) {
+    CRYPTO_store_u32_be(out + 4 * i, ctx->h[i]);
+  }
+  return 1;
+}
+
+uint8_t *SM3(const uint8_t *data, size_t len, uint8_t out[SM3_DIGEST_LENGTH]) {
+  SM3_CTX ctx;
+  SM3_Init(&ctx);
+  SM3_Update(&ctx, data, len);
+  SM3_Final(out, &ctx);
+  OPENSSL_cleanse(&ctx, sizeof(ctx));
+  return out;
+}
+
+void SM3_Transform(SM3_CTX *ctx, const uint8_t block[SM3_CBLOCK]) {
+  SM3Traits::HashBlocks(ctx->h, block, 1);
+}
+
+#else
+
+int SM3_Init(SM3_CTX *) { return 0; }
+int SM3_Update(SM3_CTX *, const void *, size_t) { return 0; }
+int SM3_Final(uint8_t[SM3_DIGEST_LENGTH], SM3_CTX *) { return 0; }
+uint8_t *SM3(const uint8_t *, size_t, uint8_t[SM3_DIGEST_LENGTH]) {
+  return nullptr;
+}
+void SM3_Transform(SM3_CTX *, const uint8_t[SM3_CBLOCK]) {
+  // No valid context can be initialized in this build. Never emit a fake hash.
+  abort();
+}
+#endif  // XENON_GM
