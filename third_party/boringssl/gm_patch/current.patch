+#ifndef OPENSSL_HEADER_SM2_H
+#define OPENSSL_HEADER_SM2_H
+
+#include <openssl/base.h>
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+// SM2 implements GB/T 32918 on the named SM2 curve. These operations are not
+// FIPS-approved. Keys use EVP_PKEY_EC with EC_group_sm2(), never ECDSA.
+#define SM2_DEFAULT_USERID "1234567812345678"
+#define SM2_DEFAULT_USERID_LENGTH 16
+#define SM2_DIGEST_LENGTH 32
+
+// SM2_compute_z_digest writes the identity binding ZA to |out|. |id_len| must
+// be less than 8192. The key must contain a public point on the SM2 curve.
+OPENSSL_EXPORT int SM2_compute_z_digest(uint8_t out[SM2_DIGEST_LENGTH],
+                                        const EC_KEY *key, const uint8_t *id,
+                                        size_t id_len);
+
+// SM2_compute_digest writes SM3(ZA || message) to |out|. Identities are
+// explicit: certificates normally use SM2_DEFAULT_USERID; RFC 8998 handshake
+// signatures use "TLSv1.3+GM+Cipher+Suite".
+OPENSSL_EXPORT int SM2_compute_digest(uint8_t out[SM2_DIGEST_LENGTH],
+                                      const EC_KEY *key, const uint8_t *id,
+                                      size_t id_len, const uint8_t *message,
+                                      size_t message_len);
+
+// SM2_sign_digest signs an already identity-bound digest and returns one on
+// success. It writes a DER SEQUENCE of INTEGER r and s to |sig|, and its length
+// to |out_len|. |max_len| must be at least ECDSA_size(key). For a size query,
+// pass a null |sig|. The private scalar must be in [1, n-2].
+OPENSSL_EXPORT int SM2_sign_digest(const uint8_t digest[SM2_DIGEST_LENGTH],
+                                   uint8_t *sig, size_t *out_len,
+                                   size_t max_len, const EC_KEY *key);
+
+// SM2_verify_digest returns one if |sig| is a valid canonical DER SM2 signature
+// of the already identity-bound |digest|, and zero otherwise.
+OPENSSL_EXPORT int SM2_verify_digest(const uint8_t digest[SM2_DIGEST_LENGTH],
+                                     const uint8_t *sig, size_t sig_len,
+                                     const EC_KEY *key);
+
+// SM2_encrypt encrypts a nonempty message using SM2 and SM3. The output is the
+// DER SEQUENCE { INTEGER C1x, INTEGER C1y, OCTET STRING C3, OCTET STRING C2 }
+// from GM/T 0009. It returns one on success. A null |out| queries the maximum
+// output length. Actual encryption sets |*out_len| to the encoded length.
+OPENSSL_EXPORT int SM2_encrypt(uint8_t *out, size_t *out_len, size_t max_out,
+                               const uint8_t *in, size_t in_len,
+                               const EC_KEY *key);
+
+// SM2_decrypt authenticates and decrypts a ciphertext produced by SM2_encrypt.
+// No plaintext is written on authentication failure. A null |out| parses the
+// ciphertext and returns its plaintext length without authenticating it.
+OPENSSL_EXPORT int SM2_decrypt(uint8_t *out, size_t *out_len, size_t max_out,
+                               const uint8_t *in, size_t in_len,
+                               const EC_KEY *key);
+
+#if defined(__cplusplus)
+}  // extern C
+#endif
+
+#endif  // OPENSSL_HEADER_SM2_H
