+namespace {
+
+// This is the substitution table specified by GB/T 32907-2016. It must never
+// be indexed with key-dependent data. The portable implementation scans every
+// entry in order and selects all four bytes with constant-time masks.
+constexpr uint8_t kSBox[256] = {
+    0xd6, 0x90, 0xe9, 0xfe, 0xcc, 0xe1, 0x3d, 0xb7, 0x16, 0xb6, 0x14, 0xc2,
+    0x28, 0xfb, 0x2c, 0x05, 0x2b, 0x67, 0x9a, 0x76, 0x2a, 0xbe, 0x04, 0xc3,
+    0xaa, 0x44, 0x13, 0x26, 0x49, 0x86, 0x06, 0x99, 0x9c, 0x42, 0x50, 0xf4,
+    0x91, 0xef, 0x98, 0x7a, 0x33, 0x54, 0x0b, 0x43, 0xed, 0xcf, 0xac, 0x62,
+    0xe4, 0xb3, 0x1c, 0xa9, 0xc9, 0x08, 0xe8, 0x95, 0x80, 0xdf, 0x94, 0xfa,
+    0x75, 0x8f, 0x3f, 0xa6, 0x47, 0x07, 0xa7, 0xfc, 0xf3, 0x73, 0x17, 0xba,
+    0x83, 0x59, 0x3c, 0x19, 0xe6, 0x85, 0x4f, 0xa8, 0x68, 0x6b, 0x81, 0xb2,
+    0x71, 0x64, 0xda, 0x8b, 0xf8, 0xeb, 0x0f, 0x4b, 0x70, 0x56, 0x9d, 0x35,
+    0x1e, 0x24, 0x0e, 0x5e, 0x63, 0x58, 0xd1, 0xa2, 0x25, 0x22, 0x7c, 0x3b,
+    0x01, 0x21, 0x78, 0x87, 0xd4, 0x00, 0x46, 0x57, 0x9f, 0xd3, 0x27, 0x52,
+    0x4c, 0x36, 0x02, 0xe7, 0xa0, 0xc4, 0xc8, 0x9e, 0xea, 0xbf, 0x8a, 0xd2,
+    0x40, 0xc7, 0x38, 0xb5, 0xa3, 0xf7, 0xf2, 0xce, 0xf9, 0x61, 0x15, 0xa1,
+    0xe0, 0xae, 0x5d, 0xa4, 0x9b, 0x34, 0x1a, 0x55, 0xad, 0x93, 0x32, 0x30,
+    0xf5, 0x8c, 0xb1, 0xe3, 0x1d, 0xf6, 0xe2, 0x2e, 0x82, 0x66, 0xca, 0x60,
+    0xc0, 0x29, 0x23, 0xab, 0x0d, 0x53, 0x4e, 0x6f, 0xd5, 0xdb, 0x37, 0x45,
+    0xde, 0xfd, 0x8e, 0x2f, 0x03, 0xff, 0x6a, 0x72, 0x6d, 0x6c, 0x5b, 0x51,
+    0x8d, 0x1b, 0xaf, 0x92, 0xbb, 0xdd, 0xbc, 0x7f, 0x11, 0xd9, 0x5c, 0x41,
+    0x1f, 0x10, 0x5a, 0xd8, 0x0a, 0xc1, 0x31, 0x88, 0xa5, 0xcd, 0x7b, 0xbd,
+    0x2d, 0x74, 0xd0, 0x12, 0xb8, 0xe5, 0xb4, 0xb0, 0x89, 0x69, 0x97, 0x4a,
+    0x0c, 0x96, 0x77, 0x7e, 0x65, 0xb9, 0xf1, 0x09, 0xc5, 0x6e, 0xc6, 0x84,
+    0x18, 0xf0, 0x7d, 0xec, 0x3a, 0xdc, 0x4d, 0x20, 0x79, 0xee, 0x5f, 0x3e,
+    0xd7, 0xcb, 0x39, 0x48,
+};
+
+#if defined(OPENSSL_X86_64) && !defined(OPENSSL_NO_ASM)
+#if defined(__clang__) || defined(__GNUC__)
+__attribute__((target("ssse3")))
+#endif
+__m128i TauVectorSSSE3(__m128i input) {
+  // All memory accesses are fixed. The low nibble selects a byte inside a
+  // register with PSHUFB, while the high nibble masks all sixteen rows.
+  __m128i mask = _mm_set1_epi8(15);
+  __m128i low = _mm_and_si128(input, mask);
+  __m128i high = _mm_and_si128(_mm_srli_epi16(input, 4), mask);
+  __m128i result = _mm_setzero_si128();
+  for (int i = 0; i < 16; i++) {
+    __m128i row =
+        _mm_loadu_si128(reinterpret_cast<const __m128i *>(kSBox + 16 * i));
+    __m128i selected = _mm_shuffle_epi8(row, low);
+    __m128i matches = _mm_cmpeq_epi8(high, _mm_set1_epi8(static_cast<char>(i)));
+    result = _mm_or_si128(result, _mm_and_si128(selected, matches));
+  }
+  return result;
+}
+
+#if defined(__clang__) || defined(__GNUC__)
+__attribute__((target("ssse3")))
+#endif
+uint32_t TauSSSE3(uint32_t x) {
+  return static_cast<uint32_t>(_mm_cvtsi128_si32(
+      TauVectorSSSE3(_mm_cvtsi32_si128(static_cast<int>(x)))));
+}
+
+void TransposeFour(__m128i &a, __m128i &b, __m128i &c, __m128i &d) {
+  const __m128i ab_lo = _mm_unpacklo_epi32(a, b);
+  const __m128i ab_hi = _mm_unpackhi_epi32(a, b);
+  const __m128i cd_lo = _mm_unpacklo_epi32(c, d);
+  const __m128i cd_hi = _mm_unpackhi_epi32(c, d);
+  a = _mm_unpacklo_epi64(ab_lo, cd_lo);
+  b = _mm_unpackhi_epi64(ab_lo, cd_lo);
+  c = _mm_unpacklo_epi64(ab_hi, cd_hi);
+  d = _mm_unpackhi_epi64(ab_hi, cd_hi);
+}
+
+template <int bits>
+__m128i RotateLeft(__m128i x) {
+  return _mm_or_si128(_mm_slli_epi32(x, bits), _mm_srli_epi32(x, 32 - bits));
+}
+
+#if defined(__clang__) || defined(__GNUC__)
+__attribute__((target("ssse3")))
+#endif
+void EncryptFourSSSE3(const uint8_t *in, uint8_t *out, const SM4_KEY *key) {
+  const __m128i reverse =
+      _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+  __m128i x0 = _mm_shuffle_epi8(
+      _mm_loadu_si128(reinterpret_cast<const __m128i *>(in)), reverse);
+  __m128i x1 = _mm_shuffle_epi8(
+      _mm_loadu_si128(reinterpret_cast<const __m128i *>(in + 16)), reverse);
+  __m128i x2 = _mm_shuffle_epi8(
+      _mm_loadu_si128(reinterpret_cast<const __m128i *>(in + 32)), reverse);
+  __m128i x3 = _mm_shuffle_epi8(
+      _mm_loadu_si128(reinterpret_cast<const __m128i *>(in + 48)), reverse);
+  // Each 32-bit lane now belongs to a different block. A single S-box scan
+  // substitutes all sixteen bytes, instead of using only four vector bytes.
+  TransposeFour(x0, x1, x2, x3);
+  for (unsigned i = 0; i < 32; i++) {
+    __m128i t = _mm_xor_si128(_mm_xor_si128(x1, x2), x3);
+    t = TauVectorSSSE3(
+        _mm_xor_si128(t, _mm_set1_epi32(static_cast<int>(key->rk[i]))));
+    const __m128i linear = _mm_xor_si128(
+        t, _mm_xor_si128(_mm_xor_si128(RotateLeft<2>(t), RotateLeft<10>(t)),
+                         _mm_xor_si128(RotateLeft<18>(t), RotateLeft<24>(t))));
+    t = _mm_xor_si128(x0, linear);
+    x0 = x1;
+    x1 = x2;
+    x2 = x3;
+    x3 = t;
+  }
+  // Reverse the four final words in each block, then restore block order.
+  TransposeFour(x3, x2, x1, x0);
+  _mm_storeu_si128(reinterpret_cast<__m128i *>(out),
+                   _mm_shuffle_epi8(x3, reverse));
+  _mm_storeu_si128(reinterpret_cast<__m128i *>(out + 16),
+                   _mm_shuffle_epi8(x2, reverse));
+  _mm_storeu_si128(reinterpret_cast<__m128i *>(out + 32),
+                   _mm_shuffle_epi8(x1, reverse));
+  _mm_storeu_si128(reinterpret_cast<__m128i *>(out + 48),
+                   _mm_shuffle_epi8(x0, reverse));
+}
+#endif
+
+#if defined(OPENSSL_AARCH64) && !defined(OPENSSL_NO_ASM)
+uint32_t TauNEON(uint32_t x) {
+  uint8x16_t input = vreinterpretq_u8_u32(vdupq_n_u32(x));
+  uint8x16_t low = vandq_u8(input, vdupq_n_u8(15));
+  uint8x16_t high = vshrq_n_u8(input, 4);
+  uint8x16_t result = vdupq_n_u8(0);
+  for (unsigned i = 0; i < 16; i++) {
+    uint8x16_t selected = vqtbl1q_u8(vld1q_u8(kSBox + 16 * i), low);
+    uint8x16_t matches = vceqq_u8(high, vdupq_n_u8(static_cast<uint8_t>(i)));
+    result = vorrq_u8(result, vandq_u8(selected, matches));
+  }
+  return vgetq_lane_u32(vreinterpretq_u32_u8(result), 0);
+}
+#endif
+
+uint32_t TauPortable(uint32_t x) {
+  uint32_t out = 0;
+  for (unsigned i = 0; i < 256; i++) {
+    uint32_t v = kSBox[i];
+    out |= (constant_time_eq_w(x & 255, i) & v) |
+           ((constant_time_eq_w((x >> 8) & 255, i) & v) << 8) |
+           ((constant_time_eq_w((x >> 16) & 255, i) & v) << 16) |
+           ((constant_time_eq_w(x >> 24, i) & v) << 24);
+  }
+  return out;
+}
+
+uint32_t Rotl(uint32_t x, unsigned n) { return (x << n) | (x >> (32 - n)); }
+
+template <uint32_t (*Substitute)(uint32_t)>
+int SetEncryptKey(const uint8_t key[SM4_KEY_SIZE], SM4_KEY *out) {
+  static constexpr uint32_t kFK[4] = {0xa3b1bac6, 0x56aa3350, 0x677d9197,
+                                      0xb27022dc};
+  uint32_t k[4];
+  for (unsigned i = 0; i < 4; i++) {
+    k[i] = CRYPTO_load_u32_be(key + 4 * i) ^ kFK[i];
+  }
+  for (unsigned i = 0; i < 32; i++) {
+    uint32_t ck = 0;
+    for (unsigned j = 0; j < 4; j++) {
+      ck = (ck << 8) | ((7 * (4 * i + j)) & 255);
+    }
+    uint32_t t = Substitute(k[1] ^ k[2] ^ k[3] ^ ck);
+    t = k[0] ^ t ^ Rotl(t, 13) ^ Rotl(t, 23);
+    k[0] = k[1];
+    k[1] = k[2];
+    k[2] = k[3];
+    k[3] = out->rk[i] = t;
+  }
+  OPENSSL_cleanse(k, sizeof(k));
+  return 1;
+}
+
+template <uint32_t (*Substitute)(uint32_t)>
+void EncryptBlock(const uint8_t *in, uint8_t *out, const SM4_KEY *key) {
+  uint32_t x[4];
+  for (unsigned i = 0; i < 4; i++) {
+    x[i] = CRYPTO_load_u32_be(in + 4 * i);
+  }
+  for (unsigned i = 0; i < 32; i++) {
+    uint32_t t = Substitute(x[1] ^ x[2] ^ x[3] ^ key->rk[i]);
+    t = x[0] ^ t ^ Rotl(t, 2) ^ Rotl(t, 10) ^ Rotl(t, 18) ^ Rotl(t, 24);
+    x[0] = x[1];
+    x[1] = x[2];
+    x[2] = x[3];
+    x[3] = t;
+  }
+  for (unsigned i = 0; i < 4; i++) {
+    CRYPTO_store_u32_be(out + 4 * i, x[3 - i]);
+  }
+  OPENSSL_cleanse(x, sizeof(x));
+}
+
+}  // namespace
+
+int SM4_set_encrypt_key(const uint8_t key[SM4_KEY_SIZE], SM4_KEY *out) {
+#if defined(OPENSSL_X86_64) && !defined(OPENSSL_NO_ASM)
+  if (CRYPTO_is_SSSE3_capable()) {
+    return SetEncryptKey<TauSSSE3>(key, out);
+  }
+#elif defined(OPENSSL_AARCH64) && !defined(OPENSSL_NO_ASM)
+  return SetEncryptKey<TauNEON>(key, out);
+#endif
+  return SetEncryptKey<TauPortable>(key, out);
+}
+
+int SM4_set_decrypt_key(const uint8_t key[SM4_KEY_SIZE], SM4_KEY *out) {
+  SM4_set_encrypt_key(key, out);
+  for (unsigned i = 0; i < 16; i++) {
+    uint32_t tmp = out->rk[i];
+    out->rk[i] = out->rk[31 - i];
+    out->rk[31 - i] = tmp;
+  }
+  return 1;
+}
+
+void SM4_encrypt(const uint8_t in[SM4_BLOCK_SIZE], uint8_t out[SM4_BLOCK_SIZE],
+                 const SM4_KEY *key) {
+  sm4_encrypt_blocks(in, out, 1, key);
+}
+
+BSSL_NAMESPACE_BEGIN
+
+void sm4_encrypt_blocks(const uint8_t *in, uint8_t *out, size_t blocks,
+                        const SM4_KEY *key) {
+#if defined(OPENSSL_X86_64) && !defined(OPENSSL_NO_ASM)
+  if (CRYPTO_is_SSSE3_capable()) {
+    while (blocks >= 4) {
+      EncryptFourSSSE3(in, out, key);
+      in += 64;
+      out += 64;
+      blocks -= 4;
+    }
+    while (blocks-- != 0) {
+      EncryptBlock<TauSSSE3>(in, out, key);
+      in += 16;
+      out += 16;
+    }
+    return;
+  }
+#endif
+  while (blocks-- != 0) {
+#if defined(OPENSSL_AARCH64) && !defined(OPENSSL_NO_ASM)
+    EncryptBlock<TauNEON>(in, out, key);
+#else
+    EncryptBlock<TauPortable>(in, out, key);
+#endif
+    in += 16;
+    out += 16;
+  }
+}
+
+BSSL_NAMESPACE_END
+
+#else
+
+int SM4_set_encrypt_key(const uint8_t[SM4_KEY_SIZE], SM4_KEY *) { return 0; }
+int SM4_set_decrypt_key(const uint8_t[SM4_KEY_SIZE], SM4_KEY *) { return 0; }
+void SM4_encrypt(const uint8_t[SM4_BLOCK_SIZE], uint8_t[SM4_BLOCK_SIZE],
+                 const SM4_KEY *) {
+  // Key setup failed in this build. Never emit unencrypted or synthetic data.
+  abort();
+}
+BSSL_NAMESPACE_BEGIN
+void sm4_encrypt_blocks(const uint8_t *, uint8_t *, size_t, const SM4_KEY *) {
+  abort();
+}
+BSSL_NAMESPACE_END
+#endif  // XENON_GM
