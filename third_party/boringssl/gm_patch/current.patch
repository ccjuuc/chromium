+bssl::UniquePtr<EC_KEY> StandardKey() {
+  bssl::UniquePtr<EC_KEY> key(EC_KEY_new_by_curve_name(NID_sm2));
+  BIGNUM *raw = nullptr;
+  if (!key || !BN_hex2bn(&raw, kPrivateKey)) {
+    return nullptr;
+  }
+  bssl::UniquePtr<BIGNUM> private_key(raw);
+  bssl::UniquePtr<EC_POINT> public_key(EC_POINT_new(EC_group_sm2()));
+  if (!public_key || !EC_KEY_set_private_key(key.get(), private_key.get()) ||
+      !EC_POINT_mul(EC_group_sm2(), public_key.get(), private_key.get(),
+                    nullptr, nullptr, nullptr) ||
+      !EC_KEY_set_public_key(key.get(), public_key.get())) {
+    return nullptr;
+  }
+  return key;
+}
+
+TEST(SM2Test, StandardSignatureAndIdentityBinding) {
+  // GB/T 32918.5-2016, Annex A, using the identity from GM/T 0009.
+  auto key = StandardKey();
+  ASSERT_TRUE(key);
+  uint8_t digest[32];
+  ASSERT_TRUE(SM2_compute_digest(digest, key.get(), kID, sizeof(kID) - 1,
+                                 kMessage, sizeof(kMessage) - 1));
+  std::vector<uint8_t> signature;
+  ASSERT_TRUE(DecodeHex(&signature,
+                        "3046022100F5A03B0648D2C4630EEAC513E1BB81A15944DA3827D5"
+                        "B74143AC7EACEEE720B3"
+                        "022100B1B6AA29DF212FD8763182BC0D421CA1BB9038FD1F7F42D4"
+                        "840B69C485BBC1AA"));
+  EXPECT_TRUE(
+      SM2_verify_digest(digest, signature.data(), signature.size(), key.get()));
+
+  uint8_t other_digest[32];
+  constexpr uint8_t kTLSID[] = "TLSv1.3+GM+Cipher+Suite";
+  ASSERT_TRUE(SM2_compute_digest(other_digest, key.get(), kTLSID,
+                                 sizeof(kTLSID) - 1, kMessage,
+                                 sizeof(kMessage) - 1));
+  EXPECT_FALSE(SM2_verify_digest(other_digest, signature.data(),
+                                 signature.size(), key.get()));
+  digest[0] ^= 1;
+  EXPECT_FALSE(
+      SM2_verify_digest(digest, signature.data(), signature.size(), key.get()));
+  digest[0] ^= 1;
+  signature.push_back(0);
+  EXPECT_FALSE(
+      SM2_verify_digest(digest, signature.data(), signature.size(), key.get()));
+  std::vector<uint8_t> zero_signature;
+  ASSERT_TRUE(DecodeHex(&zero_signature, "3006020100020101"));
+  EXPECT_FALSE(SM2_verify_digest(digest, zero_signature.data(),
+                                 zero_signature.size(), key.get()));
+  EXPECT_FALSE(SM2_compute_z_digest(digest, key.get(), kID, 8192));
+  ERR_clear_error();
+}
+
+TEST(SM2Test, SignRoundTripAndRejectECDSA) {
+  auto key = StandardKey();
+  ASSERT_TRUE(key);
+  uint8_t digest[32];
+  ASSERT_TRUE(SM2_compute_digest(digest, key.get(), kID, sizeof(kID) - 1,
+                                 kMessage, sizeof(kMessage) - 1));
+  size_t length;
+  ASSERT_TRUE(SM2_sign_digest(digest, nullptr, &length, 0, key.get()));
+  std::vector<uint8_t> signature(length);
+  ASSERT_TRUE(SM2_sign_digest(digest, signature.data(), &length,
+                              signature.size(), key.get()));
+  EXPECT_TRUE(SM2_verify_digest(digest, signature.data(), length, key.get()));
+  EXPECT_FALSE(ECDSA_verify(0, digest, sizeof(digest), signature.data(), length,
+                            key.get()));
+  unsigned ecdsa_length = 0;
+  EXPECT_FALSE(ECDSA_sign(0, digest, sizeof(digest), signature.data(),
+                          &ecdsa_length, key.get()));
+  ERR_clear_error();
+
+  bssl::UniquePtr<EC_KEY> ordinary(
+      EC_KEY_new_by_curve_name(NID_X9_62_prime256v1));
+  ASSERT_TRUE(ordinary);
+  ASSERT_TRUE(EC_KEY_generate_key(ordinary.get()));
+  EXPECT_FALSE(
+      SM2_verify_digest(digest, signature.data(), length, ordinary.get()));
+  ASSERT_TRUE(ECDSA_sign(0, digest, sizeof(digest), signature.data(),
+                         &ecdsa_length, ordinary.get()));
+  EXPECT_TRUE(ECDSA_verify(0, digest, sizeof(digest), signature.data(),
+                           ecdsa_length, ordinary.get()));
+  ERR_clear_error();
+}
