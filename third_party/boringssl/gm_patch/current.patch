+
+#include <openssl/sm2.h>
+
+#include <algorithm>
+
+#include <openssl/bn.h>
+#include <openssl/bytestring.h>
+#include <openssl/ec.h>
+#include <openssl/ec_key.h>
+#include <openssl/ecdsa.h>
+#include <openssl/err.h>
+#include <openssl/mem.h>
+#include <openssl/nid.h>
+#include <openssl/sm3.h>
+
+#include "../fipsmodule/bn/internal.h"
+#include "../fipsmodule/ec/internal.h"
+#include "../fipsmodule/service_indicator/internal.h"
+#include "../internal.h"
+#include "../mem_internal.h"
+
+#if defined(XENON_GM)
+
+using namespace bssl;
+
+namespace {
+
+// Keep ephemeral scalars, coordinates, and plaintext out of freed storage.
+template <typename T>
+struct Secret {
+  T value{};
+  ~Secret() { OPENSSL_cleanse(&value, sizeof(value)); }
+};
+
+struct SecretBytes {
+  Array<uint8_t> value;
+  ~SecretBytes() { OPENSSL_cleanse(value.data(), value.size()); }
+};
+
+// Suppress indicators from the RNG and EC helpers: an SM2 operation is never a
+// FIPS-approved service, even though it reuses those primitives.
+struct NonApprovedService {
+  NonApprovedService() { FIPS_service_indicator_lock_state(); }
+  ~NonApprovedService() { FIPS_service_indicator_unlock_state(); }
+};
+
+bool CheckKey(const EC_KEY *key, bool need_public, bool need_private) {
+  if (key == nullptr) {
+    return false;
+  }
+  const ECKey *impl = FromOpaque(key);
+  if (impl->group == nullptr || impl->group->curve_name != NID_sm2 ||
+      (need_private && impl->priv_key == nullptr) ||
+      (need_public &&
+       (impl->pub_key == nullptr ||
+        EC_POINT_is_at_infinity(impl->group, impl->pub_key) ||
+        !EC_POINT_is_on_curve(impl->group, impl->pub_key, nullptr)))) {
+    OPENSSL_PUT_ERROR(EC, EC_R_INVALID_GROUP_ORDER);
+    return false;
+  }
+  return true;
+}
+
+void DigestToScalar(const EC_GROUP *group, EC_SCALAR *out,
+                    const uint8_t digest[32]) {
+  BN_ULONG words[32 / sizeof(BN_ULONG)];
+  bn_big_endian_to_words(words, std::size(words), digest, 32);
+  ec_scalar_reduce(group, out, words, std::size(words));
+  OPENSSL_cleanse(words, sizeof(words));
+}
+
+bool PointCoordinates(const EC_GROUP *group, uint8_t out[64],
+                      const EC_JACOBIAN *point) {
+  Secret<EC_AFFINE> affine;
+  if (!ec_jacobian_to_affine(group, &affine.value, point)) {
+    return false;
+  }
+  size_t len;
+  ec_felem_to_bytes(group, out, &len, &affine.value.X);
+  BSSL_CHECK(len == 32);
+  ec_felem_to_bytes(group, out + 32, &len, &affine.value.Y);
+  BSSL_CHECK(len == 32);
+  return true;
+}
+
+bool HashBignum(SM3_CTX *ctx, const BIGNUM *n) {
+  uint8_t bytes[32];
+  return BN_bn2bin_padded(bytes, sizeof(bytes), n) &&
+         SM3_Update(ctx, bytes, sizeof(bytes));
+}
+
+bool MarshalScalar(CBB *cbb, const EC_GROUP *group, const EC_SCALAR *scalar) {
+  uint8_t bytes[32];
+  size_t len;
+  ec_scalar_to_bytes(group, bytes, &len, scalar);
+  UniquePtr<BIGNUM> bn(BN_bin2bn(bytes, len, nullptr));
+  return bn && BN_marshal_asn1(cbb, bn.get());
+}
+
+// KDF's counter is 32 bits. Return false for an all-zero mask, as required by
+// GB/T 32918.4; encryption retries with a fresh ephemeral scalar in that case.
+bool Kdf(uint8_t *out, size_t len, const uint8_t xy[64]) {
+  if (len == 0 || (len - 1) / 32 >= UINT32_MAX) {
+    return false;
+  }
+  Secret<SM3_CTX> ctx;
+  Secret<uint8_t[32]> block;
+  uint8_t nonzero = 0;
+  for (uint32_t counter = 1; len != 0; counter++) {
+    uint8_t encoded[4] = {static_cast<uint8_t>(counter >> 24),
+                          static_cast<uint8_t>(counter >> 16),
+                          static_cast<uint8_t>(counter >> 8),
+                          static_cast<uint8_t>(counter)};
+    SM3_Init(&ctx.value);
+    SM3_Update(&ctx.value, xy, 64);
+    SM3_Update(&ctx.value, encoded, sizeof(encoded));
+    SM3_Final(block.value, &ctx.value);
+    size_t todo = std::min(len, sizeof(block.value));
+    OPENSSL_memcpy(out, block.value, todo);
+    for (size_t i = 0; i < todo; i++) {
+      nonzero |= block.value[i];
+    }
+    out += todo;
+    len -= todo;
+  }
+  return constant_time_declassify_int(nonzero) != 0;
+}
+
+void HashCiphertext(uint8_t out[32], const uint8_t xy[64], const uint8_t *msg,
+                    size_t msg_len) {
+  Secret<SM3_CTX> ctx;
+  SM3_Init(&ctx.value);
+  SM3_Update(&ctx.value, xy, 32);
+  SM3_Update(&ctx.value, msg, msg_len);
+  SM3_Update(&ctx.value, xy + 32, 32);
+  SM3_Final(out, &ctx.value);
+}
+
+}  // namespace
+
+int SM2_compute_z_digest(uint8_t out[32], const EC_KEY *key, const uint8_t *id,
+                         size_t id_len) {
+  if (out == nullptr || id_len >= 8192 || (id == nullptr && id_len != 0) ||
+      !CheckKey(key, true, false)) {
+    return 0;
+  }
+  const EC_GROUP *group = EC_KEY_get0_group(key);
+  UniquePtr<BIGNUM> a(BN_new()), b(BN_new());
+  uint8_t generator[64], public_key[64];
+  if (!a || !b ||
+      !EC_GROUP_get_curve_GFp(group, nullptr, a.get(), b.get(), nullptr) ||
+      !PointCoordinates(group, generator, &group->generator.raw) ||
+      !PointCoordinates(group, public_key, &FromOpaque(key)->pub_key->raw)) {
+    return 0;
+  }
+  uint8_t entl[] = {static_cast<uint8_t>(id_len >> 5),
+                    static_cast<uint8_t>(id_len << 3)};
+  SM3_CTX ctx;
+  return SM3_Init(&ctx) && SM3_Update(&ctx, entl, sizeof(entl)) &&
+         SM3_Update(&ctx, id, id_len) && HashBignum(&ctx, a.get()) &&
+         HashBignum(&ctx, b.get()) &&
+         SM3_Update(&ctx, generator, sizeof(generator)) &&
+         SM3_Update(&ctx, public_key, sizeof(public_key)) &&
+         SM3_Final(out, &ctx);
+}
+
+int SM2_compute_digest(uint8_t out[32], const EC_KEY *key, const uint8_t *id,
+                       size_t id_len, const uint8_t *message,
+                       size_t message_len) {
+  uint8_t z[32];
+  SM3_CTX ctx;
+  return out != nullptr && (message != nullptr || message_len == 0) &&
+         SM2_compute_z_digest(z, key, id, id_len) && SM3_Init(&ctx) &&
+         SM3_Update(&ctx, z, sizeof(z)) &&
+         SM3_Update(&ctx, message, message_len) && SM3_Final(out, &ctx);
+}
+
+int SM2_sign_digest(const uint8_t digest[32], uint8_t *sig, size_t *out_len,
+                    size_t max_len, const EC_KEY *key) {
+  NonApprovedService service;
+  if (out_len == nullptr || !CheckKey(key, false, true)) {
+    return 0;
+  }
+  *out_len = 0;
+  if (sig == nullptr) {
+    *out_len = ECDSA_size(key);
+    return 1;
+  }
+  if (digest == nullptr || max_len < ECDSA_size(key)) {
+    return 0;
+  }
+  const ECKey *impl = FromOpaque(key);
+  const EC_GROUP *group = impl->group;
+  struct Scalars {
+    EC_SCALAR e, one, d1, inverse, k, x, r, s, tmp;
+  };
+  Secret<Scalars> scalars;
+  auto &v = scalars.value;
+  v.one.words[0] = 1;
+  ec_scalar_add(group, &v.d1, &impl->priv_key->scalar, &v.one);
+  if (constant_time_declassify_int(ec_scalar_is_zero(group, &v.d1))) {
+    return 0;
+  }
+  ec_scalar_inv0_montgomery(group, &v.inverse, &v.d1);
+  ec_scalar_from_montgomery(group, &v.inverse, &v.inverse);
+  DigestToScalar(group, &v.e, digest);
+
+  // Bind nonce generation to the key and message as additional RNG input. This
+  // does not replace the fresh randomness supplied by ec_random_nonzero_scalar.
+  Secret<uint8_t[64]> seed;
+  Secret<uint8_t[32]> additional;
+  size_t len;
+  ec_scalar_to_bytes(group, seed.value, &len, &impl->priv_key->scalar);
+  OPENSSL_memcpy(seed.value + 32, digest, 32);
+  SM3(seed.value, sizeof(seed.value), additional.value);
+  for (unsigned retry = 0; retry < 32; retry++) {
+    Secret<EC_JACOBIAN> point;
+    if (!ec_random_nonzero_scalar(group, &v.k, additional.value) ||
+        !ec_point_mul_scalar_base(group, &point.value, &v.k) ||
+        !ec_get_x_coordinate_as_scalar(group, &v.x, &point.value)) {
+      return 0;
+    }
+    ec_scalar_add(group, &v.r, &v.e, &v.x);
+    ec_scalar_add(group, &v.tmp, &v.r, &v.k);
+    if (constant_time_declassify_int(ec_scalar_is_zero(group, &v.r) |
+                                     ec_scalar_is_zero(group, &v.tmp))) {
+      continue;
+    }
+    ec_scalar_to_montgomery(group, &v.tmp, &v.r);
+    ec_scalar_mul_montgomery(group, &v.tmp, &v.tmp, &impl->priv_key->scalar);
+    ec_scalar_sub(group, &v.s, &v.k, &v.tmp);
+    ec_scalar_mul_montgomery(group, &v.s, &v.s, &v.inverse);
+    if (constant_time_declassify_int(ec_scalar_is_zero(group, &v.s))) {
+      continue;
+    }
+    CONSTTIME_DECLASSIFY(&v.r, sizeof(v.r));
+    CONSTTIME_DECLASSIFY(&v.s, sizeof(v.s));
+    ScopedCBB cbb;
+    CBB sequence;
+    if (!CBB_init_fixed(cbb.get(), sig, max_len) ||
+        !CBB_add_asn1(cbb.get(), &sequence, CBS_ASN1_SEQUENCE) ||
+        !MarshalScalar(&sequence, group, &v.r) ||
+        !MarshalScalar(&sequence, group, &v.s) || !CBB_flush(cbb.get())) {
+      return 0;
+    }
+    *out_len = CBB_len(cbb.get());
+    return 1;
+  }
+  OPENSSL_PUT_ERROR(ECDSA, ECDSA_R_TOO_MANY_ITERATIONS);
+  return 0;
+}
+
+int SM2_verify_digest(const uint8_t digest[32], const uint8_t *sig,
+                      size_t sig_len, const EC_KEY *key) {
+  if (digest == nullptr || sig == nullptr || !CheckKey(key, true, false)) {
+    return 0;
+  }
+  const EC_GROUP *group = EC_KEY_get0_group(key);
+  UniquePtr<ECDSA_SIG> parsed(ECDSA_SIG_from_bytes(sig, sig_len));
+  EC_SCALAR r, s, t, e, x;
+  if (!parsed ||
+      !ec_bignum_to_scalar(group, &r, ECDSA_SIG_get0_r(parsed.get())) ||
+      !ec_bignum_to_scalar(group, &s, ECDSA_SIG_get0_s(parsed.get())) ||
+      ec_scalar_is_zero(group, &r) || ec_scalar_is_zero(group, &s)) {
+    return 0;
+  }
+  ec_scalar_add(group, &t, &r, &s);
+  if (ec_scalar_is_zero(group, &t)) {
+    return 0;
+  }
+  EC_JACOBIAN point;
+  if (!ec_point_mul_scalar_public(group, &point, &s,
+                                  &FromOpaque(key)->pub_key->raw, &t) ||
+      !ec_get_x_coordinate_as_scalar(group, &x, &point)) {
+    return 0;
+  }
+  DigestToScalar(group, &e, digest);
+  ec_scalar_add(group, &x, &x, &e);
+  return ec_scalar_equal_vartime(group, &x, &r);
+}
+
+int SM2_encrypt(uint8_t *out, size_t *out_len, size_t max_out,
+                const uint8_t *in, size_t in_len, const EC_KEY *key) {
+  NonApprovedService service;
+  if (out_len == nullptr || in_len == 0 || in_len > SIZE_MAX - 160 ||
+      (in_len - 1) / 32 >= UINT32_MAX || !CheckKey(key, true, false)) {
+    return 0;
+  }
+  *out_len = 0;
+  if (out == nullptr) {
+    *out_len = in_len + 160;
+    return 1;
+  }
+  if (in == nullptr) {
+    return 0;
+  }
+  const EC_GROUP *group = EC_KEY_get0_group(key);
+  SecretBytes c2;
+  if (!c2.value.Init(in_len)) {
+    return 0;
+  }
+  for (unsigned retry = 0; retry < 32; retry++) {
+    Secret<EC_SCALAR> k;
+    Secret<EC_JACOBIAN> shared;
+    EC_JACOBIAN c1;
+    Secret<uint8_t[64]> xy;
+    uint8_t c1xy[64], c3[32];
+    const uint8_t additional[32] = {};
+    if (!ec_random_nonzero_scalar(group, &k.value, additional) ||
+        !ec_point_mul_scalar_base(group, &c1, &k.value) ||
+        !ec_point_mul_scalar(group, &shared.value,
+                             &FromOpaque(key)->pub_key->raw, &k.value) ||
+        !PointCoordinates(group, c1xy, &c1) ||
+        !PointCoordinates(group, xy.value, &shared.value)) {
+      return 0;
+    }
+    if (!Kdf(c2.value.data(), in_len, xy.value)) {
+      continue;
+    }
+    HashCiphertext(c3, xy.value, in, in_len);
+    for (size_t i = 0; i < in_len; i++) {
+      c2.value[i] ^= in[i];
+    }
+    UniquePtr<BIGNUM> x(BN_bin2bn(c1xy, 32, nullptr));
+    UniquePtr<BIGNUM> y(BN_bin2bn(c1xy + 32, 32, nullptr));
+    ScopedCBB cbb;
+    CBB sequence;
+    if (!x || !y || !CBB_init_fixed(cbb.get(), out, max_out) ||
+        !CBB_add_asn1(cbb.get(), &sequence, CBS_ASN1_SEQUENCE) ||
+        !BN_marshal_asn1(&sequence, x.get()) ||
+        !BN_marshal_asn1(&sequence, y.get()) ||
+        !CBB_add_asn1_element(&sequence, CBS_ASN1_OCTETSTRING, c3,
+                              sizeof(c3)) ||
+        !CBB_add_asn1_element(&sequence, CBS_ASN1_OCTETSTRING, c2.value.data(),
+                              c2.value.size()) ||
+        !CBB_flush(cbb.get())) {
+      return 0;
+    }
+    *out_len = CBB_len(cbb.get());
+    return 1;
+  }
+  return 0;
+}
+
+int SM2_decrypt(uint8_t *out, size_t *out_len, size_t max_out,
+                const uint8_t *in, size_t in_len, const EC_KEY *key) {
+  NonApprovedService service;
+  if (out_len == nullptr || in == nullptr || !CheckKey(key, false, true)) {
+    return 0;
+  }
+  *out_len = 0;
+  CBS cbs, sequence, c3, c2;
+  CBS_init(&cbs, in, in_len);
+  UniquePtr<BIGNUM> x(BN_new()), y(BN_new());
+  const EC_GROUP *group = EC_KEY_get0_group(key);
+  UniquePtr<EC_POINT> c1(EC_POINT_new(group));
+  if (!x || !y || !c1 || !CBS_get_asn1(&cbs, &sequence, CBS_ASN1_SEQUENCE) ||
+      CBS_len(&cbs) != 0 || !BN_parse_asn1_unsigned(&sequence, x.get()) ||
+      !BN_parse_asn1_unsigned(&sequence, y.get()) ||
+      !CBS_get_asn1(&sequence, &c3, CBS_ASN1_OCTETSTRING) ||
+      CBS_len(&c3) != 32 ||
+      !CBS_get_asn1(&sequence, &c2, CBS_ASN1_OCTETSTRING) ||
+      CBS_len(&sequence) != 0 || CBS_len(&c2) == 0 ||
+      (CBS_len(&c2) - 1) / 32 >= UINT32_MAX ||
+      !EC_POINT_set_affine_coordinates_GFp(group, c1.get(), x.get(), y.get(),
+                                           nullptr)) {
+    return 0;
+  }
+  if (out == nullptr) {
+    *out_len = CBS_len(&c2);
+    return 1;
+  }
+  if (max_out < CBS_len(&c2)) {
+    return 0;
+  }
+  SecretBytes plaintext;
+  Secret<EC_JACOBIAN> shared;
+  Secret<uint8_t[64]> xy;
+  Secret<uint8_t[32]> tag;
+  if (!plaintext.value.Init(CBS_len(&c2)) ||
+      !ec_point_mul_scalar(group, &shared.value, &c1->raw,
+                           &FromOpaque(key)->priv_key->scalar) ||
+      !PointCoordinates(group, xy.value, &shared.value) ||
+      !Kdf(plaintext.value.data(), plaintext.value.size(), xy.value)) {
+    return 0;
+  }
+  for (size_t i = 0; i < plaintext.value.size(); i++) {
+    plaintext.value[i] ^= CBS_data(&c2)[i];
+  }
+  HashCiphertext(tag.value, xy.value, plaintext.value.data(),
+                 plaintext.value.size());
+  if (CRYPTO_memcmp(tag.value, CBS_data(&c3), sizeof(tag.value)) != 0) {
+    return 0;
+  }
+  OPENSSL_memcpy(out, plaintext.value.data(), plaintext.value.size());
+  *out_len = plaintext.value.size();
+  return 1;
+}
