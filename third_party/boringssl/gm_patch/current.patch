+TEST(SM2Test, StandardCiphertextAndTampering) {
+  // GB/T 32918.5-2016 Annex C, encoded according to GM/T 0009 section 7.2.
+  auto key = StandardKey();
+  ASSERT_TRUE(key);
+  std::vector<uint8_t> ciphertext;
+  ASSERT_TRUE(DecodeHex(
+      &ciphertext,
+      "307C022004EBFC718E8D1798620432268E77FEB6415E2EDE0E073C0F4F640ECD2E149A73"
+      "022100E858F9D81E5430A57B36DAAB8F950A3C64E6EE6A63094D99283AFF767E124DF0"
+      "042059983C18F809E262923C53AEC295D30383B54E39D609D160AFCB1908D0BD8766"
+      "041321886CA989CA9C7D58087307CA93092D651EFA"));
+  size_t length;
+  ASSERT_TRUE(SM2_decrypt(nullptr, &length, 0, ciphertext.data(),
+                          ciphertext.size(), key.get()));
+  std::vector<uint8_t> plaintext(length);
+  ASSERT_TRUE(SM2_decrypt(plaintext.data(), &length, plaintext.size(),
+                          ciphertext.data(), ciphertext.size(), key.get()));
+  EXPECT_EQ(Bytes("encryption standard"), Bytes(plaintext));
+
+  ciphertext.back() ^= 1;
+  std::fill(plaintext.begin(), plaintext.end(), 0xa5);
+  EXPECT_FALSE(SM2_decrypt(plaintext.data(), &length, plaintext.size(),
+                           ciphertext.data(), ciphertext.size(), key.get()));
+  EXPECT_EQ(0u, length);
+  EXPECT_TRUE(std::all_of(plaintext.begin(), plaintext.end(),
+                          [](uint8_t v) { return v == 0xa5; }));
+  ciphertext.back() ^= 1;
+  ciphertext[74] ^= 1;  // C3 authentication tag.
+  EXPECT_FALSE(SM2_decrypt(plaintext.data(), &length, plaintext.size(),
+                           ciphertext.data(), ciphertext.size(), key.get()));
+  ciphertext[74] ^= 1;
+  ciphertext[4] ^= 1;  // C1 is now outside the curve.
+  EXPECT_FALSE(SM2_decrypt(plaintext.data(), &length, plaintext.size(),
+                           ciphertext.data(), ciphertext.size(), key.get()));
+  ERR_clear_error();
+}
