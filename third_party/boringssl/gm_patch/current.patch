+int SSL_set_gm_mode(SSL *ssl, int mode) {
+  auto *s = FromOpaque(ssl);
+  if (s->config == nullptr || s->s3->hs == nullptr || s->s3->version != 0 ||
+      s->s3->hs->state != 0 || s->s3->initial_handshake_complete ||
+      s->method->is_dtls || s->quic_method != nullptr ||
+      mode < SSL_GM_MODE_DISABLED || mode > SSL_GM_MODE_TLCP ||
+      (mode != SSL_GM_MODE_DISABLED &&
+       s->config->compliance_policy != ssl_compliance_policy_none)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+#if !defined(XENON_GM)
+  if (mode != SSL_GM_MODE_DISABLED) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+#endif
+  const bool only =
+      mode == SSL_GM_MODE_RFC8998_ONLY || mode == SSL_GM_MODE_TLCP;
+  const auto &defaults = s->ctx->supported_group_list;
+  const bool add_sm2 = mode != SSL_GM_MODE_DISABLED &&
+                       (only || std::find(defaults.begin(), defaults.end(),
+                                          SSL_GROUP_SM2) == defaults.end());
+  const size_t count = only ? 0 : defaults.size();
+  Array<uint16_t> groups;
+  Array<uint32_t> flags;
+  if (!groups.Init(count + add_sm2)) {
+    return 0;
+  }
+  if (count != 0) {
+    OPENSSL_memcpy(groups.data(), defaults.data(), count * sizeof(uint16_t));
+    if (!s->ctx->supported_group_list_flags.empty()) {
+      if (!flags.Init(groups.size())) {
+        return 0;
+      }
+      OPENSSL_memcpy(flags.data(), s->ctx->supported_group_list_flags.data(),
+                     count * sizeof(uint32_t));
+    }
+  }
+  if (add_sm2) {
+    groups[count] = SSL_GROUP_SM2;
+  }
+  s->config->supported_group_list = std::move(groups);
+  s->config->supported_group_list_flags = std::move(flags);
+  s->config->client_key_share_selections.reset();
+  s->config->gm_cipher_suites.Reset();
+  s->config->gm_mode = mode;
+  return 1;
+}
