+TEST(SSLTest, GMProtocolTLCPReferenceRecordAndFinished) {
+  // Independent vectors computed with the fixed Tongsuo 8.5.0 libcrypto:
+  // MAC key = 00..1f, SM4 key = 20..2f, explicit IV = 30..3f, sequence = 0.
+  // The full record tests the TLCP wire version in the MAC, explicit IV,
+  // padding, and record-parser integration, not only the underlying cipher.
+  static const uint8_t kReferenceRecord[] = {
+      0x17, 0x01, 0x01, 0x00, 0x50, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35,
+      0x36, 0x37, 0x38, 0x39, 0x3a, 0x3b, 0x3c, 0x3d, 0x3e, 0x3f, 0x29,
+      0xdf, 0xe2, 0x34, 0xc0, 0x25, 0x48, 0xa5, 0xd8, 0x6f, 0x67, 0xe4,
+      0xec, 0xe7, 0x58, 0x41, 0x8e, 0xbd, 0x6b, 0xf9, 0xc7, 0xa3, 0x3e,
+      0x52, 0x3e, 0x60, 0x3d, 0x41, 0xd6, 0x3e, 0xe4, 0x7f, 0x51, 0xe1,
+      0x6e, 0x1b, 0x8b, 0xbc, 0x84, 0xf6, 0xdb, 0x03, 0xd5, 0xf8, 0xd4,
+      0x77, 0x0b, 0x97, 0xd5, 0xd0, 0x23, 0x69, 0xba, 0x4f, 0x29, 0x06,
+      0x54, 0xf4, 0xa3, 0x13, 0xfb, 0x35, 0xd9, 0x7a,
+  };
+  uint8_t material[64];
+  for (size_t i = 0; i < sizeof(material); i++) {
+    material[i] = static_cast<uint8_t>(i);
+  }
+  const SSL_CIPHER *cipher =
+      SSL_get_cipher_by_value(SSL_CIPHER_TLCP_ECC_SM4_CBC_SM3);
+  ASSERT_NE(cipher, nullptr);
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  for (int corruption = 0; corruption < 5; corruption++) {
+    SCOPED_TRACE(corruption);
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    ASSERT_TRUE(SSL_set_gm_mode(ssl.get(), SSL_GM_MODE_TLCP));
+    auto *impl = FromOpaque(ssl.get());
+    impl->s3->version = TLCP1_1_VERSION;
+    impl->s3->aead_read_ctx = SSLAEADContext::Create(
+        evp_aead_open, TLCP1_1_VERSION, cipher, Span(material).subspan(32, 16),
+        Span(material).first<32>(), {});
+    ASSERT_TRUE(impl->s3->aead_read_ctx);
+    std::vector<uint8_t> record(std::begin(kReferenceRecord),
+                                std::end(kReferenceRecord));
+    if (corruption == 1) {
+      record[1] = 3;  // Correct ciphertext under the wrong wire version.
+      record[2] = 3;
+    } else if (corruption == 2) {
+      record.back() ^= 1;  // Padding corruption.
+    } else if (corruption == 3) {
+      record[5] ^= 1;  // Explicit IV corruption.
+    } else if (corruption == 4) {
+      impl->s3->read_sequence = 1;  // Replay under a different sequence number.
+    }
+    Span<uint8_t> plaintext;
+    size_t consumed;
+    uint8_t type, alert;
+    auto result = tls_open_record(impl, &type, &plaintext, &consumed, &alert,
+                                  Span(record.data(), record.size()));
+    if (corruption == 0) {
+      ASSERT_EQ(result, ssl_open_record_success);
+      EXPECT_EQ(type, SSL3_RT_APPLICATION_DATA);
+      EXPECT_EQ(consumed, sizeof(kReferenceRecord));
+      EXPECT_EQ(Bytes(plaintext), Bytes("TLCP record regression"));
+    } else {
+      EXPECT_EQ(result, ssl_open_record_error);
+      EXPECT_EQ(alert, corruption == 1 ? SSL_AD_PROTOCOL_VERSION
+                                       : SSL_AD_BAD_RECORD_MAC);
+      ERR_clear_error();
+    }
+  }
+
+  // Finished is PRF-SM3(master_secret, label, SM3(transcript))[0..11].
+  // The reference uses master_secret=00..2f and transcript=00..7f.
+  uint8_t transcript_bytes[128];
+  for (size_t i = 0; i < sizeof(transcript_bytes); i++) {
+    transcript_bytes[i] = static_cast<uint8_t>(i);
+  }
+  SSLTranscript transcript(/*is_dtls=*/false);
+  ASSERT_TRUE(transcript.Init());
+  ASSERT_TRUE(transcript.Update(transcript_bytes));
+  ASSERT_TRUE(transcript.InitHash(TLS1_1_VERSION, cipher));
+  auto session = ssl_session_new(FromOpaque(ctx.get())->x509_method);
+  ASSERT_TRUE(session);
+  session->secret.CopyFrom(Span(material).first<48>());
+  static const uint8_t kClientFinished[] = {
+      0x78, 0xd3, 0x12, 0x5e, 0x23, 0xa3, 0xe6, 0x67, 0xf8, 0x5d, 0xd2, 0x77,
+  };
+  static const uint8_t kServerFinished[] = {
+      0x9f, 0xf0, 0x06, 0xee, 0xa1, 0x69, 0x1c, 0x6e, 0x7a, 0x1d, 0x5b, 0x73,
+  };
+  uint8_t finished[EVP_MAX_MD_SIZE];
+  size_t len;
+  ASSERT_TRUE(transcript.GetFinishedMAC(finished, &len, session.get(), false));
+  EXPECT_EQ(Bytes(finished, len), Bytes(kClientFinished));
+  ASSERT_TRUE(transcript.GetFinishedMAC(finished, &len, session.get(), true));
+  EXPECT_EQ(Bytes(finished, len), Bytes(kServerFinished));
+}
