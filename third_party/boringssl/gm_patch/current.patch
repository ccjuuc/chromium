+TEST(SSLTest, GMProtocolSM2IdentityAndAlgorithmIsolation) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  auto sm2_key = GetGMTestKey();
+  auto p256_key = GetECDSATestKey();
+  ASSERT_TRUE(sm2_key);
+  ASSERT_TRUE(p256_key);
+  const auto input = StringAsBytes("SM2 protocol identity separation");
+  const auto tls_id = StringAsBytes("TLSv1.3+GM+Cipher+Suite");
+  const auto tlcp_id = StringAsBytes("1234567812345678");
+  for (bool tlcp : {false, true}) {
+    SCOPED_TRACE(tlcp);
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    ASSERT_TRUE(SSL_set_gm_mode(ssl.get(),
+                                tlcp ? SSL_GM_MODE_TLCP : SSL_GM_MODE_RFC8998));
+    auto *impl = FromOpaque(ssl.get());
+    impl->s3->version = tlcp ? TLCP1_1_VERSION : TLS1_3_VERSION;
+    impl->s3->hs->new_cipher = SSL_get_cipher_by_value(
+        tlcp ? SSL_CIPHER_TLCP_ECC_SM4_CBC_SM3 : SSL_CIPHER_SM4_GCM_SM3);
+    for (bool use_tlcp_id : {false, true}) {
+      auto id = use_tlcp_id ? tlcp_id : tls_id;
+      uint8_t digest[SM2_DIGEST_LENGTH], signature[80];
+      size_t signature_len;
+      const EC_KEY *key = EVP_PKEY_get0_EC_KEY(sm2_key.get());
+      ASSERT_TRUE(SM2_compute_digest(digest, key, id.data(), id.size(),
+                                     input.data(), input.size()));
+      ASSERT_TRUE(SM2_sign_digest(digest, signature, &signature_len,
+                                  sizeof(signature), key));
+      EXPECT_EQ(ssl_public_key_verify(impl, Span(signature, signature_len),
+                                      SSL_SIGN_SM2_SM3, sm2_key.get(), input),
+                tlcp == use_tlcp_id);
+      ERR_clear_error();
+    }
+    EXPECT_FALSE(ssl_pkey_supports_algorithm(impl, p256_key.get(),
+                                             SSL_SIGN_ECDSA_SECP256R1_SHA256,
+                                             /*is_verify=*/true));
+    EXPECT_FALSE(ssl_pkey_supports_algorithm(impl, sm2_key.get(),
+                                             SSL_SIGN_ECDSA_SECP256R1_SHA256,
+                                             /*is_verify=*/true));
+    impl->s3->hs->new_cipher =
+        SSL_get_cipher_by_value(SSL_CIPHER_AES_128_GCM_SHA256);
+    EXPECT_FALSE(ssl_pkey_supports_algorithm(impl, sm2_key.get(),
+                                             SSL_SIGN_SM2_SM3, true));
+  }
