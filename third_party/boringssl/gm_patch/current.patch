+TEST(SSLTest, GMProtocolTLCPRequiresDualCertificateVerifier) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  ASSERT_TRUE(SSL_set_gm_mode(ssl.get(), SSL_GM_MODE_TLCP));
+  std::vector<uint8_t> hello;
+  // The default single-chain verifier must not silently accept a dual-leaf
+  // TLCP chain. Fail before sending anything unless a dual verifier is set.
+  EXPECT_FALSE(GetClientHello(ssl.get(), &hello));
+  ERR_clear_error();
+
+  ssl.reset(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  ASSERT_TRUE(SSL_set_gm_mode(ssl.get(), SSL_GM_MODE_TLCP));
+  SSL_set_custom_verify(ssl.get(), SSL_VERIFY_PEER,
+                        [](SSL *, uint8_t *) { return ssl_verify_ok; });
+  ASSERT_TRUE(GetClientHello(ssl.get(), &hello));
+  CBS record(hello), handshake, body, session_id, suites;
+  uint8_t type;
+  uint16_t version;
+  ASSERT_TRUE(CBS_get_u8(&record, &type));
+  EXPECT_EQ(type, SSL3_RT_HANDSHAKE);
+  ASSERT_TRUE(CBS_get_u16(&record, &version));
+  EXPECT_EQ(version, TLCP1_1_VERSION);
+  ASSERT_TRUE(CBS_get_u16_length_prefixed(&record, &handshake));
+  ASSERT_TRUE(CBS_get_u8(&handshake, &type));
+  EXPECT_EQ(type, SSL3_MT_CLIENT_HELLO);
+  ASSERT_TRUE(CBS_get_u24_length_prefixed(&handshake, &body));
+  ASSERT_TRUE(CBS_get_u16(&body, &version));
+  EXPECT_EQ(version, TLCP1_1_VERSION);
+  ASSERT_TRUE(CBS_skip(&body, SSL3_RANDOM_SIZE));
+  ASSERT_TRUE(CBS_get_u8_length_prefixed(&body, &session_id));
+  ASSERT_TRUE(CBS_get_u16_length_prefixed(&body, &suites));
+  const uint8_t kExpected[] = {0xe0, 0x53, 0xe0, 0x13};
+  EXPECT_EQ(Bytes(suites), Bytes(kExpected));
+  CBS compression, extensions;
+  ASSERT_TRUE(CBS_get_u8_length_prefixed(&body, &compression));
+  ASSERT_TRUE(CBS_get_u16_length_prefixed(&body, &extensions));
+  bool found_groups = false;
+  while (CBS_len(&extensions) != 0) {
+    uint16_t extension_type;
+    CBS contents;
+    ASSERT_TRUE(CBS_get_u16(&extensions, &extension_type));
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &contents));
+    if (extension_type == TLSEXT_TYPE_supported_groups) {
+      CBS groups;
+      ASSERT_TRUE(CBS_get_u16_length_prefixed(&contents, &groups));
+      uint16_t group;
+      ASSERT_TRUE(CBS_get_u16(&groups, &group));
+      EXPECT_EQ(group, SSL_GROUP_SM2);
+      EXPECT_EQ(CBS_len(&groups), 0u);
+      found_groups = true;
+    }
+  }
+  EXPECT_TRUE(found_groups);
+}
