+#include "../test/test_util.h"
+#include "internal.h"
+
+namespace {
+
+#if defined(XENON_GM)
+
+TEST(SM4Test, StandardBlockVector) {
+  // GB/T 32907-2016, Appendix A.1.
+  const uint8_t key_bytes[16] = {0x01, 0x23, 0x45, 0x67, 0x89, 0xab,
+                                 0xcd, 0xef, 0xfe, 0xdc, 0xba, 0x98,
+                                 0x76, 0x54, 0x32, 0x10};
+  SM4_KEY key;
+  ASSERT_TRUE(SM4_set_encrypt_key(key_bytes, &key));
+  uint8_t block[16];
+  SM4_encrypt(key_bytes, block, &key);
+  EXPECT_EQ("681edf34d206965e86b3e94f536e4246", EncodeHex(block));
+  ASSERT_TRUE(SM4_set_decrypt_key(key_bytes, &key));
+  SM4_encrypt(block, block, &key);
+  EXPECT_EQ(Bytes(key_bytes), Bytes(block));
+}
+
+TEST(SM4Test, CTRSplitAndInPlace) {
+  const uint8_t key[16] = {0}, iv[16] = {0};
+  uint8_t input[47] = {0}, encrypted[47], decrypted[47];
+  bssl::ScopedEVP_CIPHER_CTX enc, dec;
+  ASSERT_TRUE(EVP_EncryptInit_ex(enc.get(), EVP_sm4_ctr(), nullptr, key, iv));
+  int len;
+  ASSERT_TRUE(
+      EVP_EncryptUpdate(enc.get(), encrypted, &len, input, sizeof(input)));
+  ASSERT_EQ(sizeof(input), static_cast<size_t>(len));
+  bssl::OPENSSL_memcpy(decrypted, encrypted, sizeof(encrypted));
+  ASSERT_TRUE(EVP_DecryptInit_ex(dec.get(), EVP_sm4_ctr(), nullptr, key, iv));
+  for (size_t i = 0; i < sizeof(decrypted); i++) {
+    ASSERT_TRUE(
+        EVP_DecryptUpdate(dec.get(), decrypted + i, &len, decrypted + i, 1));
+    ASSERT_EQ(1, len);
+  }
+  EXPECT_EQ(Bytes(input), Bytes(decrypted));
+}
+
+TEST(SM4Test, MultipleBlocksReference) {
+  // Independent OpenSSL 3.5.7 SM4-ECB output for the sequence 00..8f, with
+  // padding disabled. Distinct blocks detect lane swaps in the SIMD path.
+  std::vector<uint8_t> expected, key_bytes;
+  ASSERT_TRUE(DecodeHex(&key_bytes, "0123456789abcdeffedcba9876543210"));
+  ASSERT_TRUE(DecodeHex(
+      &expected,
+      "06989c613da668ad2a8df782e1a8f96a4b910651754b5553f10cfa0c8a09e9e5f"
+      "42952cf94ac83688437c9b671d6c7fad55bfd68e7901219f41fab48427ab58d7"
+      "18e2043bac7ec8bfd57a907118650150c2c0fab0b4e22ee8de3028b161a7c371"
+      "cd7855afd87ef606bcfedad65c86b5b596849dc7c7a6d63ca3a767538d15ef62"
+      "74ce8f040d663da6e6dab9c5638b0f0"));
+  uint8_t input[144];
+  for (size_t i = 0; i < sizeof(input); i++) {
+    input[i] = static_cast<uint8_t>(i);
+  }
+  SM4_KEY enc, dec;
+  ASSERT_TRUE(SM4_set_encrypt_key(key_bytes.data(), &enc));
+  ASSERT_TRUE(SM4_set_decrypt_key(key_bytes.data(), &dec));
+  for (size_t blocks = 0; blocks <= 9; blocks++) {
+    SCOPED_TRACE(blocks);
+    const size_t len = blocks * 16;
+    // Offsetting both buffers also exercises unaligned loads and stores.
+    std::vector<uint8_t> source(len + 2, 0xa5), output(len + 2, 0xa5);
+    bssl::OPENSSL_memcpy(source.data() + 1, input, len);
+    bssl::sm4_encrypt_blocks(source.data() + 1, output.data() + 1, blocks,
+                             &enc);
+    EXPECT_EQ(Bytes(expected.data(), len), Bytes(output.data() + 1, len));
+    EXPECT_EQ(0xa5, output.front());
+    EXPECT_EQ(0xa5, output.back());
+    bssl::sm4_encrypt_blocks(output.data() + 1, output.data() + 1, blocks,
+                             &dec);
+    EXPECT_EQ(source, output);
+    bssl::sm4_encrypt_blocks(source.data() + 1, source.data() + 1, blocks,
+                             &enc);
+    EXPECT_EQ(Bytes(expected.data(), len), Bytes(source.data() + 1, len));
+    EXPECT_EQ(0xa5, source.front());
+    EXPECT_EQ(0xa5, source.back());
+  }
+}
+
+TEST(SM4Test, CTRBatchBoundaryAndCounterCarry) {
+  // Independent OpenSSL 3.5.7 SM4-CTR output. The fourth counter causes a
+  // carry into byte 11, which must be retained by both batch and tail paths.
+  std::vector<uint8_t> expected, key, iv;
+  ASSERT_TRUE(DecodeHex(&key, "0123456789abcdeffedcba9876543210"));
+  ASSERT_TRUE(DecodeHex(&iv, "ffeeddccbbaa998877665544fffffffc"));
+  ASSERT_TRUE(DecodeHex(
+      &expected,
+      "d765a5512f255dc7304e3407820c49cb2e200dfe0984a617bbffd04b822d4d17"
+      "564fa3742aa16050f4275f62815eac1768efe398d5e73d6f87d7602ad204ec35"
+      "8f4a5af1025a57cf97917522382bce298d080bfe6c67eba98887df9fd7aa479d"
+      "44433688bd2554960fe0c0b871b4b8ac81485ad075f29962239624dd7cfee7c7"
+      "941d8c11c94667c761700dd535804116e14238a5a5e9ffb079a12e7ddbe40cb2"
+      "b5c7a9745fbbc4908750f4a202986bf0a50c9c090d2b75e5142d5de2f243fc5f"
+      "ec"));
+  uint8_t input[193];
+  for (size_t i = 0; i < sizeof(input); i++) {
+    input[i] = static_cast<uint8_t>(i);
+  }
+  for (size_t len : {size_t{0}, size_t{1}, size_t{15}, size_t{16}, size_t{17},
+                     size_t{63}, size_t{64}, size_t{65}, size_t{127},
+                     size_t{128}, size_t{129}, sizeof(input)}) {
+    SCOPED_TRACE(len);
+    // Every split tests continuity of the partial keystream, including a
+    // partial block followed by a complete batch and a later tail.
+    for (size_t split = 0; split <= len; split++) {
+      SCOPED_TRACE(split);
+      for (bool in_place : {false, true}) {
+        SCOPED_TRACE(in_place);
+        uint8_t output[sizeof(input)];
+        bssl::OPENSSL_memcpy(output, input, sizeof(input));
+        const uint8_t *source = in_place ? output : input;
+        bssl::ScopedEVP_CIPHER_CTX ctx;
+        ASSERT_TRUE(EVP_EncryptInit_ex(ctx.get(), EVP_sm4_ctr(), nullptr,
+                                       key.data(), iv.data()));
+        int written;
+        ASSERT_TRUE(EVP_EncryptUpdate(ctx.get(), output, &written, source,
+                                      static_cast<int>(split)));
+        ASSERT_EQ(split, static_cast<size_t>(written));
+        ASSERT_TRUE(EVP_EncryptUpdate(ctx.get(), output + split, &written,
+                                      source + split,
+                                      static_cast<int>(len - split)));
+        ASSERT_EQ(len - split, static_cast<size_t>(written));
+        EXPECT_EQ(Bytes(expected.data(), len), Bytes(output, len));
+        EXPECT_EQ(Bytes(input + len, sizeof(input) - len),
+                  Bytes(output + len, sizeof(input) - len));
+      }
+    }
+  }
+}
+
+TEST(SM4Test, TLCPRecordAuthentication) {
+  uint8_t key[48] = {0}, iv[16] = {0}, aad[11] = {0};
+  uint8_t input[193];
+  for (size_t i = 0; i < sizeof(input); i++) {
+    input[i] = static_cast<uint8_t>(i);
+  }
+  bssl::ScopedEVP_AEAD_CTX enc, dec;
+  ASSERT_TRUE(EVP_AEAD_CTX_init_with_direction(
+      enc.get(), EVP_aead_sm4_cbc_sm3_tls(), key, sizeof(key),
+      EVP_AEAD_DEFAULT_TAG_LENGTH, evp_aead_seal));
+  ASSERT_TRUE(EVP_AEAD_CTX_init_with_direction(
+      dec.get(), EVP_aead_sm4_cbc_sm3_tls(), key, sizeof(key),
+      EVP_AEAD_DEFAULT_TAG_LENGTH, evp_aead_open));
+  for (size_t len : {size_t{0}, size_t{1}, size_t{15}, size_t{16}, size_t{17},
+                     sizeof(input)}) {
+    SCOPED_TRACE(len);
+    uint8_t encrypted[256], decrypted[256];
+    size_t encrypted_len, decrypted_len;
+    ASSERT_TRUE(EVP_AEAD_CTX_seal(enc.get(), encrypted, &encrypted_len,
+                                  sizeof(encrypted), iv, sizeof(iv), input, len,
+                                  aad, sizeof(aad)));
+    if (len == 0) {
+      // Independently computed with OpenSSL 3: HMAC-SM3 over the 13-byte
+      // record header, followed by sixteen 0x0f padding bytes, then SM4-CBC.
+      EXPECT_EQ(
+          "f69df83b1f6b1712bed1fc41a7b4e92d390bbe968aa29666e7fd57fed788729e"
+          "000bf65df13f6275565bffe940fd9a0a",
+          EncodeHex(bssl::Span(encrypted, encrypted_len)));
+    }
+    ASSERT_TRUE(EVP_AEAD_CTX_open(dec.get(), decrypted, &decrypted_len,
+                                  sizeof(decrypted), iv, sizeof(iv), encrypted,
+                                  encrypted_len, aad, sizeof(aad)));
+    EXPECT_EQ(Bytes(input, len), Bytes(decrypted, decrypted_len));
+    // A modified ciphertext must fail with cleared output.
+    encrypted[0] ^= 1;
+    bssl::OPENSSL_memset(decrypted, 0xff, sizeof(decrypted));
+    EXPECT_FALSE(EVP_AEAD_CTX_open(dec.get(), decrypted, &decrypted_len,
+                                   sizeof(decrypted), iv, sizeof(iv), encrypted,
+                                   encrypted_len, aad, sizeof(aad)));
+    EXPECT_EQ(0u, decrypted_len);
+    uint8_t zeros[256] = {0};
+    EXPECT_EQ(Bytes(zeros), Bytes(decrypted));
+    ERR_clear_error();
+  }
+}
+
+#else
+
+TEST(SM4Test, DisabledBuildRejectsAlgorithms) {
+  EXPECT_EQ(nullptr, EVP_sm4_cbc());
+  EXPECT_EQ(nullptr, EVP_sm4_ctr());
+  EXPECT_EQ(nullptr, EVP_aead_sm4_gcm());
+  EXPECT_EQ(nullptr, EVP_aead_sm4_ccm());
+  EXPECT_EQ(nullptr, EVP_aead_sm4_cbc_sm3_tls());
+  EXPECT_EQ(nullptr, EVP_get_cipherbyname("SM4-CBC"));
+  EXPECT_EQ(nullptr, EVP_get_cipherbyname("SM4-CTR"));
+  uint8_t bytes[SM4_KEY_SIZE] = {};
+  SM4_KEY key = {};
+  EXPECT_FALSE(SM4_set_encrypt_key(bytes, &key));
+  EXPECT_FALSE(SM4_set_decrypt_key(bytes, &key));
+}
+
+#endif  // XENON_GM
+
+}  // namespace
