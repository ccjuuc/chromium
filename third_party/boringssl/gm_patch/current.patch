+int SM4CipherInit(EVP_CIPHER_CTX *ctx, const uint8_t *key, const uint8_t *,
+                  int enc) {
+  auto *schedule = static_cast<SM4_KEY *>(ctx->cipher_data);
+  if (enc || EVP_CIPHER_CTX_mode(ctx) == EVP_CIPH_CTR_MODE) {
+    return SM4_set_encrypt_key(key, schedule);
+  }
+  return SM4_set_decrypt_key(key, schedule);
+}
+
+int SM4CBCUpdate(EVP_CIPHER_CTX *ctx, uint8_t *out, const uint8_t *in,
+                 size_t len) {
+  const auto *key = static_cast<const SM4_KEY *>(ctx->cipher_data);
+  assert(len % 16 == 0);
+  uint8_t block[16], saved[16];
+  while (len != 0) {
+    if (ctx->encrypt) {
+      for (size_t j = 0; j < 16; j++) {
+        block[j] = in[j] ^ ctx->iv[j];
+      }
+      SM4_encrypt(block, out, key);
+      OPENSSL_memcpy(ctx->iv, out, 16);
+    } else {
+      OPENSSL_memcpy(saved, in, 16);
+      SM4_encrypt(in, block, key);
+      for (size_t j = 0; j < 16; j++) {
+        out[j] = block[j] ^ ctx->iv[j];
+      }
+      OPENSSL_memcpy(ctx->iv, saved, 16);
+    }
+    in += 16;
+    out += 16;
+    len -= 16;
+  }
+  OPENSSL_cleanse(block, sizeof(block));
+  OPENSSL_cleanse(saved, sizeof(saved));
+  return 1;
+}
+
+void Increment(uint8_t counter[16], size_t first_byte) {
+  // The counter contains no secret data.
+  for (size_t i = 16; i > first_byte; i--) {
+    if (++counter[i - 1] != 0) {
+      break;
+    }
+  }
+}
+
+// |counter| is the next unused counter. Only generate complete groups of four
+// when they can all be consumed in this span; |stream| and |used| preserve a
+// partial single block across EVP updates and AEAD iovec boundaries.
+void SM4CTRBytes(const SM4_KEY *key, uint8_t *out, const uint8_t *in,
+                 size_t len, uint8_t counter[16], size_t first_counter_byte,
+                 uint8_t stream[16], size_t *used) {
+  while (len != 0 && *used != 0) {
+    *out++ = *in++ ^ stream[*used];
+    *used = (*used + 1) & 15;
+    len--;
+  }
+  if (len >= 64) {
+    uint8_t blocks[64];
+    do {
+      for (size_t i = 0; i < 4; i++) {
+        OPENSSL_memcpy(blocks + 16 * i, counter, 16);
+        Increment(counter, first_counter_byte);
+      }
+      sm4_encrypt_blocks(blocks, blocks, 4, key);
+      for (size_t i = 0; i < sizeof(blocks); i++) {
+        out[i] = in[i] ^ blocks[i];
+      }
+      in += sizeof(blocks);
+      out += sizeof(blocks);
+      len -= sizeof(blocks);
+    } while (len >= sizeof(blocks));
+    OPENSSL_cleanse(blocks, sizeof(blocks));
+  }
+  for (size_t i = 0; i < len; i++) {
+    if (*used == 0) {
+      SM4_encrypt(counter, stream, key);
+      Increment(counter, first_counter_byte);
+    }
+    out[i] = in[i] ^ stream[*used];
+    *used = (*used + 1) & 15;
+  }
+}
+
+int SM4CTRUpdate(EVP_CIPHER_CTX *ctx, uint8_t *out, const uint8_t *in,
+                 size_t len) {
+  const auto *key = static_cast<const SM4_KEY *>(ctx->cipher_data);
+  size_t used = ctx->num;
+  SM4CTRBytes(key, out, in, len, ctx->iv, 0, ctx->buf, &used);
+  ctx->num = static_cast<unsigned>(used);
+  return 1;
+}
