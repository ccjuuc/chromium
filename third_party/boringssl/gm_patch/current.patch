+int SSL_set1_gm_cipher_suites(SSL *ssl, const uint16_t *suites,
+                              size_t num_suites) {
+#if defined(XENON_GM)
+  auto *s = FromOpaque(ssl);
+  if (s->config == nullptr || s->s3->hs == nullptr || s->s3->version != 0 ||
+      s->s3->hs->state != 0 || s->config->gm_mode == SSL_GM_MODE_DISABLED ||
+      (num_suites != 0 && suites == nullptr)) {
+    return 0;
+  }
+  Span<const uint16_t> input(suites, num_suites);
+  for (size_t i = 0; i < input.size(); i++) {
+    const SSL_CIPHER *cipher = SSL_get_cipher_by_value(input[i]);
+    if (cipher == nullptr ||
+        (!ssl_cipher_is_rfc8998(cipher) && !ssl_cipher_is_tlcp(cipher)) ||
+        !ssl_cipher_allowed_gm_mode(cipher, s->config->gm_mode) ||
+        std::find(input.begin(), input.begin() + i, input[i]) !=
+            input.begin() + i) {
+      return 0;
+    }
+  }
+  return s->config->gm_cipher_suites.CopyFrom(input);
+#else
+  return 0;
+#endif  // XENON_GM
