+TEST(SSLTest, GMProtocolServerHelloGroupIsolation) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  const struct {
+    uint16_t cipher;
+    uint16_t group;
+    bool allowed;
+  } kTests[] = {
+      {SSL_CIPHER_SM4_GCM_SM3, SSL_GROUP_X25519, false},
+      {SSL_CIPHER_SM4_CCM_SM3, SSL_GROUP_X25519, false},
+      {SSL_CIPHER_AES_128_GCM_SHA256, SSL_GROUP_SM2, false},
+      {SSL_CIPHER_SM4_GCM_SM3, SSL_GROUP_SM2, true},
+      {SSL_CIPHER_SM4_CCM_SM3, SSL_GROUP_SM2, true},
+      {SSL_CIPHER_AES_128_GCM_SHA256, SSL_GROUP_X25519, true},
+  };
+  for (const auto &test : kTests) {
+    SCOPED_TRACE(test.cipher);
+    SCOPED_TRACE(test.group);
+    UniquePtr<SSL> client(SSL_new(ctx.get()));
+    ASSERT_TRUE(client);
+    ASSERT_TRUE(SSL_set_gm_mode(client.get(), SSL_GM_MODE_RFC8998));
+    const uint16_t groups[] = {SSL_GROUP_X25519, SSL_GROUP_SM2};
+    ASSERT_TRUE(SSL_set1_group_ids(client.get(), groups, std::size(groups)));
+    ASSERT_TRUE(
+        SSL_set1_client_key_shares(client.get(), groups, std::size(groups)));
+    UniquePtr<BIO> rbio(BIO_new(BIO_s_mem())), wbio(BIO_new(BIO_s_mem()));
+    ASSERT_TRUE(rbio);
+    ASSERT_TRUE(wbio);
+    SSL_set0_rbio(client.get(), rbio.release());
+    SSL_set0_wbio(client.get(), wbio.release());
+    SSL_set_connect_state(client.get());
+    int ret = SSL_do_handshake(client.get());
+    ASSERT_EQ(ret, -1);
+    ASSERT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_WANT_READ);
+
+    // Feed a real ServerHello through the record and handshake parsers. Both
+    // groups were offered, so membership alone must not authorize the pair.
+    auto *hs = FromOpaque(client.get())->s3->hs.get();
+    UniquePtr<SSLKeyShare> peer_share = SSLKeyShare::Create(test.group);
+    ASSERT_TRUE(peer_share);
+    ScopedCBB cbb;
+    CBB record, body, session_id, extensions, contents, key_exchange;
+    const uint8_t random[SSL3_RANDOM_SIZE] = {0};
+    ASSERT_TRUE(CBB_init(cbb.get(), 256));
+    ASSERT_TRUE(CBB_add_u8(cbb.get(), SSL3_RT_HANDSHAKE));
+    ASSERT_TRUE(CBB_add_u16(cbb.get(), TLS1_2_VERSION));
+    ASSERT_TRUE(CBB_add_u16_length_prefixed(cbb.get(), &record));
+    ASSERT_TRUE(CBB_add_u8(&record, SSL3_MT_SERVER_HELLO));
+    ASSERT_TRUE(CBB_add_u24_length_prefixed(&record, &body));
+    ASSERT_TRUE(CBB_add_u16(&body, TLS1_2_VERSION));
+    ASSERT_TRUE(CBB_add_bytes(&body, random, sizeof(random)));
+    ASSERT_TRUE(CBB_add_u8_length_prefixed(&body, &session_id));
+    ASSERT_TRUE(CBB_add_bytes(&session_id, hs->session_id.data(),
+                              hs->session_id.size()));
+    ASSERT_TRUE(CBB_add_u16(&body, test.cipher));
+    ASSERT_TRUE(CBB_add_u8(&body, 0));
+    ASSERT_TRUE(CBB_add_u16_length_prefixed(&body, &extensions));
+    ASSERT_TRUE(CBB_add_u16(&extensions, TLSEXT_TYPE_supported_versions));
+    ASSERT_TRUE(CBB_add_u16_length_prefixed(&extensions, &contents));
+    ASSERT_TRUE(CBB_add_u16(&contents, TLS1_3_VERSION));
+    ASSERT_TRUE(CBB_add_u16(&extensions, TLSEXT_TYPE_key_share));
+    ASSERT_TRUE(CBB_add_u16_length_prefixed(&extensions, &contents));
+    ASSERT_TRUE(CBB_add_u16(&contents, test.group));
+    ASSERT_TRUE(CBB_add_u16_length_prefixed(&contents, &key_exchange));
+    ASSERT_TRUE(peer_share->Generate(&key_exchange));
+    ASSERT_TRUE(CBB_flush(cbb.get()));
+    ASSERT_EQ(BIO_write(SSL_get_rbio(client.get()), CBB_data(cbb.get()),
+                        CBB_len(cbb.get())),
+              static_cast<int>(CBB_len(cbb.get())));
+    ret = SSL_do_handshake(client.get());
+    EXPECT_EQ(ret, -1);
+    if (test.allowed) {
+      EXPECT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_WANT_READ);
+      EXPECT_EQ(SSL_get_group_id(client.get()), test.group);
+    } else {
+      EXPECT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_SSL);
+      EXPECT_TRUE(ErrorsAreAndClear({{ERR_LIB_SSL, SSL_R_WRONG_CURVE}}));
+    }
+  }
+}
