    "DuiLib/Utils/TrayIcon.cpp",
    "DuiLib/Utils/UIDelegate.cpp",
    "DuiLib/Utils/UIShadow.cpp",
    "DuiLib/Utils/unzip.cpp",
    "DuiLib/Utils/Utils.cpp",
    "DuiLib/Utils/WinImplBase.cpp",
  ]

  public_configs = [
    ":duilib_config",
    ":duilib_warnings",
  ]
  configs -= [ "//build/config/compiler:chromium_code" ]
